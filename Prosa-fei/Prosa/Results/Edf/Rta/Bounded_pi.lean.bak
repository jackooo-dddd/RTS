    Prosa.Analysis.Abstract.Ideal_jlfp_rta.cumulative_interference_from_hep_jobs_from_other_tasks
      (Task := Task) sched j t1 (t1 + Δ) ≤
    service_of_jobs sched
      (fun jo => hep_job jo j && decide (job_task (Task := Task) jo ≠ tsk))
