    task_interference_is_bounded_by
      arr_seq sched tsk
      (Prosa.Analysis.Abstract.Ideal_jlfp_rta.interference sched)
      (Prosa.Analysis.Abstract.Ideal_jlfp_rta.interfering_workload arr_seq sched)
      (fun _ A R => priority_inversion_bound +
        bound_on_total_hep_workload tsk ts A R) := by sorry

end TaskInterferenceIsBoundedByIBF

section SolutionOfResponseTimeReccurenceExists

variable (j : Job)
variable (H_j_arrives : arrives_in arr_seq j)
variable (H_job_of_tsk : job_of_task tsk j = true)
variable (H_job_cost_positive : job_cost_positive j)

noncomputable def total_interference_bound_fn
    (tsk : Task) [TaskDeadline Task] [TaskCost Task] [MaxArrivals Task]
    [TaskRunToCompletionThreshold Task]
    (ts : List Task) (priority_inversion_bound : duration)
    (A Δ : duration) :=
  task_request_bound_function tsk (A + ε) - task_cost tsk +
    (priority_inversion_bound + bound_on_total_hep_workload tsk ts A Δ)

variable (A : duration)
variable (H_A_is_in_abstract_search_space :
  Prosa.Analysis.Abstract.Search_space.is_in_search_space tsk L
    (fun tsk' A' R' =>
      total_interference_bound_fn tsk' ts priority_inversion_bound A' R') A)

include H_R_is_maximum H_A_is_in_abstract_search_space in
lemma A_is_in_concrete_search_space :
    is_in_search_space_edf tsk ts L A = true := by
  rcases H_A_is_in_abstract_search_space with rfl | ⟨⟨hPOS, hLT⟩, x, hx, hNE⟩
  · -- Case A = 0
    simp only [is_in_search_space_edf, Bool.and_eq_true, decide_eq_true_eq]
    constructor
    · exact H_L_positive
    · left
      simp only [task_rbf_changes_at, decide_eq_true_eq]
      intro h
      have h0 := task_rbf_0_zero arr_seq H_arrival_times_are_consistent tsk
                    (H_valid_arrival_curve tsk H_tsk_in_ts).1 (H_is_arrival_curve tsk H_tsk_in_ts)
      simp [ε] at h
      rw [h0] at h
      have h1 := task_rbf_1_ge_task_cost arr_seq H_arrival_times_are_consistent tsk
                    (max_arrivals := inferInstance)
                    (H_valid_arrival_curve tsk H_tsk_in_ts).1
      have hcost : 0 < job_cost j := H_job_cost_positive
      have hle : job_cost j ≤ task_cost tsk := by
        have := H_valid_job_cost j (by exact H_j_arrives)
        rw [show job_of_task tsk j = true from H_job_of_tsk] at this
        simp at this
        exact this
      omega
  · -- Case A > 0
    simp only [is_in_search_space_edf, Bool.and_eq_true, decide_eq_true_eq]
    constructor
    · exact hLT
    · by_contra hContra
      push_neg at hContra
      obtain ⟨hNotRBF, hNotHep⟩ := hContra
      apply hNE
      simp only [total_interference_bound_fn, bound_on_total_hep_workload]
      simp only [task_rbf_changes_at, decide_eq_true_eq, not_not] at hNotRBF
      simp only [bound_on_total_hep_workload_changes_at, Bool.not_eq_true] at hNotHep
      simp only [ε] at *
      rw [show A - 1 + 1 = A from by omega]
      rw [hNotRBF]
      congr 1; congr 1
      -- Need to show the sums are equal
      apply List.map_congr_left
      intro tsk_o htsk_o
      simp only [List.mem_filter, decide_eq_true_eq] at htsk_o
      simp only [Bool.any_eq_true, decide_eq_true_eq, Bool.and_eq_true] at hNotHep
      congr 1
      have hNotHep' : ¬ ∃ x_1 ∈ ts, tsk ≠ x_1 ∧ (task_request_bound_function x_1 (A + task_deadline tsk - task_deadline x_1) ≠ task_request_bound_function x_1 (A + 1 + task_deadline tsk - task_deadline x_1)) := by
        push_neg; intro y hy hne; push_neg at hNotHep
        exact hNotHep y hy hne
      have := hNotHep' tsk_o htsk_o.1 htsk_o.2.symm
      push_neg at this
      -- The min values should be equal
      congr 1
      omega


include H_R_is_maximum H_A_is_in_abstract_search_space in
theorem correct_search_space :
    ∃ F,
      A + F = task_request_bound_function tsk (A + ε) -
                (task_cost tsk - task_run_to_completion_threshold tsk) +
              (priority_inversion_bound +
                bound_on_total_hep_workload tsk ts A (A + F)) ∧
      F + (task_cost tsk - task_run_to_completion_threshold tsk) ≤ R := by
  obtain ⟨F, hFIX, hNEQ⟩ := H_R_is_maximum A (A_is_in_concrete_search_space tsk priority_inversion_bound L R H_R_is_maximum ts A H_A_is_in_abstract_search_space)
  exact ⟨F, by omega, hNEQ⟩

end SolutionOfResponseTimeReccurenceExists

end FillingOutHypothesesOfAbstractRTATheorem

include H_arrival_times_are_consistent H_arr_seq_is_a_set
  H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute
  H_completed_jobs_dont_execute H_work_conserving H_sequential_tasks
  H_valid_job_cost H_all_jobs_from_taskset H_valid_arrival_curve H_is_arrival_curve
  H_tsk_in_ts H_valid_preemption_model H_valid_run_to_completion_threshold
  H_priority_inversion_is_bounded H_L_positive H_fixed_point H_R_is_maximum in
theorem uniprocessor_response_time_bound_edf :
    task_response_time_bound arr_seq sched tsk R := by
  intro js ARRs TSKs
  by_cases POS : job_cost js > 0
  · exact Prosa.Analysis.Abstract.Abstract_seq_rta.uniprocessor_response_time_bound_seq
      arr_seq H_arrival_times_are_consistent H_arr_seq_is_a_set
      sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute
      H_completed_jobs_dont_execute H_valid_job_cost
      ts tsk H_tsk_in_ts H_valid_preemption_model H_valid_run_to_completion_threshold
      H_valid_arrival_curve H_is_arrival_curve
      (Prosa.Analysis.Abstract.Ideal_jlfp_rta.interference sched)
      (Prosa.Analysis.Abstract.Ideal_jlfp_rta.interfering_workload arr_seq sched)
      (instantiated_i_and_w_are_coherent_with_schedule arr_seq H_arrival_times_are_consistent
        H_arr_seq_is_a_set sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute
        H_completed_jobs_dont_execute H_work_conserving H_sequential_tasks tsk)
      H_sequential_tasks
      (instantiated_interference_and_workload_consistent_with_sequential_tasks arr_seq
        H_arrival_times_are_consistent H_arr_seq_is_a_set sched H_jobs_come_from_arrival_sequence
        H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_tasks tsk)
      L
      (instantiated_busy_intervals_are_bounded arr_seq H_arrival_times_are_consistent
        H_arr_seq_is_a_set sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute
        H_completed_jobs_dont_execute H_work_conserving H_sequential_tasks H_valid_job_cost
        ts H_is_arrival_curve tsk H_L_positive H_fixed_point)
      (fun _ A R => priority_inversion_bound + bound_on_total_hep_workload tsk ts A R)
      (instantiated_task_interference_is_bounded arr_seq H_arrival_times_are_consistent
        H_arr_seq_is_a_set sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute
        H_completed_jobs_dont_execute H_sequential_tasks H_valid_job_cost ts H_all_jobs_from_taskset
        H_is_arrival_curve tsk priority_inversion_bound H_priority_inversion_is_bounded)
      R
      (fun A hA => correct_search_space tsk priority_inversion_bound L R H_R_is_maximum ts A
        (by exact hA))
      js ARRs TSKs
  · simp only [not_lt, Nat.le_zero] at POS
    unfold job_response_time_bound completed_by
    rw [POS]; simp

end AbstractRTAforEDFwithArrivalCurves

end Prosa.Results.Edf.Rta.Bounded_pi
