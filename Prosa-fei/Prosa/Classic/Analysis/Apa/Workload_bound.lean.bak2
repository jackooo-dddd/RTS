namespace WorkloadBound

section WorkloadBoundDef

variable {sporadic_task : Type} [DecidableEq sporadic_task]
variable (task_cost : sporadic_task → Time)
variable (task_period : sporadic_task → Time)

variable (tsk : sporadic_task)
variable (R_tsk : Time)
variable (delta : Time)

def max_jobs : ℕ :=
  div_floor (delta + R_tsk - task_cost tsk) (task_period tsk)

def W : ℕ :=
  let e_k := task_cost tsk
  let p_k := task_period tsk
  min e_k (delta + R_tsk - e_k - max_jobs task_cost task_period tsk R_tsk delta * p_k) +
    max_jobs task_cost task_period tsk R_tsk delta * e_k

end WorkloadBoundDef

section BasicLemmas

variable {sporadic_task : Type} [DecidableEq sporadic_task]
variable (task_cost : sporadic_task → Time)
variable (task_period : sporadic_task → Time)

variable (tsk : sporadic_task)

variable (H_period_positive : task_period tsk > 0)

variable (R1 R2 : Time)
variable (H_R_lower_bound : R1 ≥ task_cost tsk)
variable (H_R1_le_R2 : R1 ≤ R2)
include H_period_positive H_R_lower_bound H_R1_le_R2

include H_period_positive H_R_lower_bound H_R1_le_R2 in
theorem W_monotonic :
    ∀ (t1 t2 : Time),
      t1 ≤ t2 →
      W task_cost task_period tsk R1 t1 ≤
        W task_cost task_period tsk R2 t2 := by
  sorry

end BasicLemmas

section ProofWorkloadBound

variable {sporadic_task : Type} [DecidableEq sporadic_task]
variable (task_cost : sporadic_task → Time)
variable (task_period : sporadic_task → Time)
variable (task_deadline : sporadic_task → Time)

variable {Job : Type} [DecidableEq Job]
variable (job_arrival : Job → Time)
variable (job_cost : Job → Time)
variable (job_task : Job → sporadic_task)
variable (job_deadline : Job → Time)

variable (arr_seq : Prosa.Classic.Model.Arrival.Basic.Arrival_sequence.arrival_sequence Job)

variable (H_jobs_have_valid_parameters :
  ∀ (j : Job),
    Prosa.Classic.Model.Arrival.Basic.Arrival_sequence.arrives_in arr_seq j →
    Prosa.Classic.Model.Arrival.Basic.Job.valid_sporadic_job task_cost task_deadline job_cost job_deadline job_task j)

variable {num_cpus : ℕ}
variable (sched : schedule Job num_cpus)
variable (H_jobs_come_from_arrival_sequence :
  jobs_come_from_arrival_sequence sched arr_seq)

variable (H_jobs_must_arrive_to_execute :
  jobs_must_arrive_to_execute job_arrival sched)

variable (H_completed_jobs_dont_execute :
  completed_jobs_dont_execute job_cost sched)

variable (H_sequential_jobs : sequential_jobs sched)

variable (H_sporadic_tasks :
  sporadic_task_model task_period job_arrival job_task arr_seq)

variable (tsk : sporadic_task)

variable (H_valid_task_parameters :
  is_valid_sporadic_task task_cost task_period task_deadline tsk)

variable (H_constrained_deadline : task_deadline tsk ≤ task_period tsk)

variable (t1 delta : Time)

variable (R_tsk : Time)

variable (H_response_time_bound :
  ∀ (j : Job),
    Prosa.Classic.Model.Arrival.Basic.Arrival_sequence.arrives_in arr_seq j →
    job_task j = tsk →
    job_arrival j + R_tsk < t1 + delta →
    completed job_cost sched j (job_arrival j + R_tsk))

variable (H_response_time_ge_cost : R_tsk ≥ task_cost tsk)
variable (H_no_deadline_miss : R_tsk ≤ task_deadline tsk)

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence
  H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute
  H_sequential_jobs H_sporadic_tasks H_valid_task_parameters
  H_constrained_deadline H_response_time_bound
  H_response_time_ge_cost H_no_deadline_miss

private noncomputable def mk_sorted_jobs
    (ja : Job → Time) (jt : Job → sporadic_task) (s : schedule Job num_cpus)
    (tk : sporadic_task) (t1' delta' : Time) : List Job :=
  (jobs_of_task_scheduled_between jt s tk t1' (t1' + delta')).mergeSort
    (fun x y => decide (ja x ≤ ja y))

omit H_jobs_have_valid_parameters H_jobs_must_arrive_to_execute
  H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks
  H_valid_task_parameters H_constrained_deadline H_response_time_bound
  H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_simpl_by_sorting_scheduled_jobs :
    workload_joblist job_task sched tsk t1 (t1 + delta) =
      ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).map
        (fun i => service_during sched i t1 (t1 + delta))).sum := by
  unfold workload_joblist mk_sorted_jobs
  set sj := jobs_of_task_scheduled_between job_task sched tsk t1 (t1 + delta)
  set sorted := sj.mergeSort (fun x y => decide (job_arrival x ≤ job_arrival y))
  set f := fun i => service_during sched i t1 (t1 + delta)
  have h_perm := List.mergeSort_perm sj (fun x y => decide (job_arrival x ≤ job_arrival y))
  have h_nodup : sj.Nodup := by
    unfold sj jobs_of_task_scheduled_between
    exact List.Nodup.filter _ (List.nodup_dedup _)
  have h_sum_eq : (sj.map f).sum = (sorted.map f).sum :=
    (h_perm.symm.map f).sum_eq
  rw [List.sum_toFinset f h_nodup]
  exact h_sum_eq

omit H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence
  H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute
  H_sequential_jobs H_sporadic_tasks H_valid_task_parameters
  H_constrained_deadline H_response_time_bound
  H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_job_in_same_sequence :
    ∀ (j : Job),
      (j ∈ jobs_of_task_scheduled_between job_task sched tsk t1 (t1 + delta)) =
        (j ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta) := by
  intro j
  unfold mk_sorted_jobs
  exact propext ((List.mergeSort_perm _ _).symm.mem_iff)

omit H_jobs_have_valid_parameters H_jobs_must_arrive_to_execute
  H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks
  H_valid_task_parameters H_constrained_deadline H_response_time_bound
  H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_all_jobs_from_tsk :
    ∀ (j_i : Job),
      j_i ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta →
      Prosa.Classic.Model.Arrival.Basic.Arrival_sequence.arrives_in arr_seq j_i ∧
      job_task j_i = tsk ∧
      service_during sched j_i t1 (t1 + delta) ≠ 0 ∧
      j_i ∈ jobs_scheduled_between sched t1 (t1 + delta) := by
  intro j_i h_in
  unfold mk_sorted_jobs at h_in
  have h_perm := List.mergeSort_perm (jobs_of_task_scheduled_between job_task sched tsk t1 (t1 + delta)) (fun x y => decide (job_arrival x ≤ job_arrival y))
  have h_in' : j_i ∈ jobs_of_task_scheduled_between job_task sched tsk t1 (t1 + delta) :=
    h_perm.mem_iff.mp h_in
  unfold jobs_of_task_scheduled_between at h_in'
  rw [List.mem_filter] at h_in'
  obtain ⟨h_in_sched, h_tsk⟩ := h_in'
  have h_task : job_task j_i = tsk := by simpa using h_tsk
  unfold jobs_scheduled_between at h_in_sched
  rw [List.mem_dedup] at h_in_sched
  obtain ⟨i, h_mem_i, h_range_lo, h_range_hi⟩ :=
    Prosa.Util.Bigcat.mem_bigcat_nat_exists j_i t1 (t1 + delta) _ h_in_sched
  rw [mem_scheduled_jobs_eq_scheduled] at h_mem_i
  have h_arrives : Prosa.Classic.Model.Arrival.Basic.Arrival_sequence.arrives_in arr_seq j_i :=
    H_jobs_come_from_arrival_sequence j_i i h_mem_i
  have h_serv_at_ne : service_at sched j_i i ≠ 0 := by
    intro h_eq; exact ((not_scheduled_no_service sched j_i i).mpr h_eq) h_mem_i
  have h_serv_ne : service_during sched j_i t1 (t1 + delta) ≠ 0 :=
    service_implies_cumulative_service sched j_i i t1 (t1 + delta) h_range_lo h_range_hi h_serv_at_ne
  have h_in_jsb : j_i ∈ jobs_scheduled_between sched t1 (t1 + delta) := by
    unfold jobs_scheduled_between; rw [List.mem_dedup]
    exact Prosa.Util.Bigcat.mem_bigcat_nat j_i t1 (t1 + delta) i _ ⟨h_range_lo, h_range_hi⟩
      ((mem_scheduled_jobs_eq_scheduled sched j_i i).mpr h_mem_i)
  exact ⟨h_arrives, h_task, h_serv_ne, h_in_jsb⟩

omit H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence
  H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute
  H_sequential_jobs H_sporadic_tasks H_valid_task_parameters
  H_constrained_deadline H_response_time_bound
  H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_jobs_ordered_by_arrival :
    ∀ (i : ℕ) (elem : Job),
      i < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length - 1 →
      decide (job_arrival
        ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD i elem) ≤
       job_arrival
        ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (i + 1) elem)) = true := by
  intro i elem h_lt
  unfold mk_sorted_jobs at h_lt ⊢
  set sorted := (jobs_of_task_scheduled_between job_task sched tsk t1 (t1 + delta)).mergeSort
    (fun x y => decide (job_arrival x ≤ job_arrival y))
  have h_trans : ∀ a b c : Job,
      (decide (job_arrival a ≤ job_arrival b) = true) →
      (decide (job_arrival b ≤ job_arrival c) = true) →
      (decide (job_arrival a ≤ job_arrival c) = true) := by
    intro a b c hab hbc; simp only [decide_eq_true_eq] at hab hbc ⊢; exact le_trans hab hbc
  have h_total : ∀ a b : Job,
      (decide (job_arrival a ≤ job_arrival b) || decide (job_arrival b ≤ job_arrival a)) = true := by
    intro a b; simp only [Bool.or_eq_true, decide_eq_true_eq]; exact le_total (job_arrival a) (job_arrival b)
  have h_pw : sorted.Pairwise (fun a b => decide (job_arrival a ≤ job_arrival b) = true) :=
    List.pairwise_mergeSort h_trans h_total _
  exact sort_ordered _ sorted elem i (List.Pairwise.isChain h_pw) h_lt

theorem workload_bound_holds_for_at_most_n_k_jobs :
    (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length ≤
      max_jobs task_cost task_period tsk R_tsk delta →
    ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).map
      (fun i => service_during sched i t1 (t1 + delta))).sum ≤
      W task_cost task_period tsk R_tsk delta := by
  intro h_le
  set sorted := mk_sorted_jobs job_arrival job_task sched tsk t1 delta
  set f := fun i => service_during sched i t1 (t1 + delta)
  -- Each job's service ≤ task_cost tsk
  have h_each : ∀ j, j ∈ sorted → f j ≤ task_cost tsk := by
    intro j hj
    have h_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta j hj
    obtain ⟨h_arr, h_tsk, _, _⟩ := h_props
    exact cumulative_service_le_task_cost task_cost task_deadline job_cost job_deadline job_task sched
      H_completed_jobs_dont_execute tsk j h_tsk (H_jobs_have_valid_parameters _ h_arr) t1 (t1 + delta)
  -- sum of services ≤ sorted.length * task_cost tsk
  have h_sum_le : (sorted.map f).sum ≤ sorted.length * task_cost tsk := by
    have h_bound : ∀ x, x ∈ sorted.map f → x ≤ task_cost tsk := by
      intro x hx; rw [List.mem_map] at hx
      obtain ⟨j', hj', rfl⟩ := hx; exact h_each j' hj'
    calc (sorted.map f).sum
        ≤ (sorted.map f).length * task_cost tsk := List.sum_le_card_nsmul _ _ (fun x hx => h_bound x hx)
      _ = sorted.length * task_cost tsk := by rw [List.length_map]
  -- sorted.length * task_cost tsk ≤ n_k * task_cost tsk ≤ W
  calc (sorted.map f).sum ≤ sorted.length * task_cost tsk := h_sum_le
    _ ≤ max_jobs task_cost task_period tsk R_tsk delta * task_cost tsk := Nat.mul_le_mul_right _ h_le
    _ ≤ W task_cost task_period tsk R_tsk delta := Nat.le_add_left _ _

theorem workload_bound_j_fst_is_job_of_tsk
    (H_at_least_one_job :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length > 0)
    (elem : Job) :
    let j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
    Prosa.Classic.Model.Arrival.Basic.Arrival_sequence.arrives_in arr_seq j_fst ∧
    job_task j_fst = tsk ∧
    service_during sched j_fst t1 (t1 + delta) ≠ 0 ∧
    j_fst ∈ jobs_scheduled_between sched t1 (t1 + delta) := by
  intro j_fst
  have h_mem : j_fst ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
    unfold j_fst; rw [List.getD_eq_getElem (hn := H_at_least_one_job)]
    exact List.getElem_mem H_at_least_one_job
  exact workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta _ h_mem

theorem workload_bound_holds_for_a_single_job
    (H_at_least_one_job :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length > 0)
    (elem : Job) :
    ∑ i ∈ Finset.Ico 0 1,
      service_during sched
        ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD i elem)
        t1 (t1 + delta) ≤
      W task_cost task_period tsk R_tsk delta := by
  have : Finset.Ico 0 1 = {0} := by decide
  rw [this, Finset.sum_singleton]
  set sorted := mk_sorted_jobs job_arrival job_task sched tsk t1 delta
  set j_fst := sorted.getD 0 elem
  have h_fst_mem : j_fst ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
    unfold j_fst
    rw [List.getD_eq_getElem (hn := H_at_least_one_job)]
    exact List.getElem_mem H_at_least_one_job
  have h_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta j_fst h_fst_mem
  obtain ⟨h_arr, h_tsk, _, _⟩ := h_props
  have h_serv_le_cost : service_during sched j_fst t1 (t1 + delta) ≤ task_cost tsk :=
    cumulative_service_le_task_cost task_cost task_deadline job_cost job_deadline job_task sched
      H_completed_jobs_dont_execute tsk j_fst h_tsk (H_jobs_have_valid_parameters _ h_arr) t1 (t1 + delta)
  have h_serv_le_delta : service_during sched j_fst t1 (t1 + delta) ≤ delta :=
    cumulative_service_le_delta sched j_fst H_sequential_jobs t1 delta
  unfold W max_jobs
  set n_k := div_floor (delta + R_tsk - task_cost tsk) (task_period tsk)
  cases n_k with
  | zero =>
    simp only [Nat.zero_mul, Nat.add_zero, Nat.sub_zero]
    apply Nat.le_min.mpr
    constructor
    · exact h_serv_le_cost
    · have hge : task_cost tsk ≤ R_tsk := H_response_time_ge_cost
      calc service_during sched j_fst t1 (t1 + delta)
          ≤ delta := h_serv_le_delta
        _ ≤ delta + R_tsk - task_cost tsk := Nat.le_sub_of_add_le (Nat.add_le_add_left hge delta)
  | succ k =>
    calc service_during sched j_fst t1 (t1 + delta)
        ≤ task_cost tsk := h_serv_le_cost
      _ = 1 * task_cost tsk := (Nat.one_mul _).symm
      _ ≤ (k + 1) * task_cost tsk := Nat.mul_le_mul_right _ (Nat.succ_le_succ (Nat.zero_le _))
      _ ≤ min (task_cost tsk) (delta + R_tsk - task_cost tsk - (k + 1) * task_period tsk) +
          (k + 1) * task_cost tsk := Nat.le_add_left _ _

theorem workload_bound_j_lst_is_job_of_tsk
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
    Prosa.Classic.Model.Arrival.Basic.Arrival_sequence.arrives_in arr_seq j_lst ∧
    job_task j_lst = tsk ∧
    service_during sched j_lst t1 (t1 + delta) ≠ 0 ∧
    j_lst ∈ jobs_scheduled_between sched t1 (t1 + delta) := by
  intro j_lst
  have h_lt : num_mid_jobs + 1 < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length := by
    rw [H_at_least_two_jobs]; omega
  have h_mem : j_lst ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
    unfold j_lst; rw [List.getD_eq_getElem (hn := h_lt)]
    exact List.getElem_mem h_lt
  exact workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta _ h_mem

theorem workload_bound_response_time_of_first_job_inside_interval
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
    t1 ≤ job_arrival j_fst + R_tsk := by
  intro j_fst
  by_contra h_lt
  push_neg at h_lt
  have h_sz : 0 < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length := by
    rw [H_at_least_two_jobs]; omega
  have h_fst_mem : j_fst ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
    unfold j_fst
    rw [List.getD_eq_getElem (hn := h_sz)]
    exact List.getElem_mem h_sz
  have h_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta j_fst h_fst_mem
  obtain ⟨h_arr, h_tsk, h_serv_ne, _⟩ := h_props
  have h_rt : job_arrival j_fst + R_tsk < t1 + delta := by
    calc job_arrival j_fst + R_tsk < t1 := h_lt
      _ ≤ t1 + delta := Nat.le_add_right _ _
  have h_comp := H_response_time_bound j_fst h_arr h_tsk h_rt
  have h_ge : t1 ≥ job_arrival j_fst + R_tsk := Nat.le_of_lt_succ (Nat.lt_succ_of_lt h_lt)
  have h_zero := cumulative_service_after_job_rt_zero job_arrival job_cost sched
    H_completed_jobs_dont_execute j_fst R_tsk h_comp t1 (t1 + delta) h_ge
  apply h_serv_ne
  unfold service_during
  exact h_zero

theorem workload_bound_last_job_arrives_before_end_of_interval
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
    job_arrival j_lst < t1 + delta := by
  intro j_lst
  by_contra h_ge
  push_neg at h_ge
  have h_lt : num_mid_jobs + 1 < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length := by
    rw [H_at_least_two_jobs]; omega
  have h_lst_mem : j_lst ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
    unfold j_lst
    rw [List.getD_eq_getElem (hn := h_lt)]
    exact List.getElem_mem h_lt
  have h_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta j_lst h_lst_mem
  obtain ⟨_, _, h_serv_ne, _⟩ := h_props
  apply h_serv_ne
  unfold service_during
  exact cumulative_service_before_job_arrival_zero job_arrival sched j_lst
    H_jobs_must_arrive_to_execute t1 (t1 + delta) h_ge

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks H_valid_task_parameters H_constrained_deadline H_response_time_bound H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_service_of_first_and_last_jobs
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
    let j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
    service_during sched j_fst t1 (t1 + delta) +
    service_during sched j_lst t1 (t1 + delta) ≤
      (job_arrival j_fst + R_tsk - t1) +
      (t1 + delta - job_arrival j_lst) := by
  intro j_fst j_lst
  apply Nat.add_le_add
  -- Bound service of j_fst: service_during sched j_fst t1 (t1 + delta) ≤ job_arrival j_fst + R_tsk - t1
  . -- service_during ≤ sum over [t1, job_arrival j_fst + R_tsk) of service_at ≤ sum of 1 = job_arrival j_fst + R_tsk - t1
    have h_sz : 0 < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length := by
      rw [H_at_least_two_jobs]; omega
    have h_fst_mem : j_fst ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
      unfold_let j_fst; rw [List.getD_eq_getElem (hn := h_sz)]
      exact List.getElem_mem h_sz
    have h_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta j_fst h_fst_mem
    obtain ⟨h_arr, h_tsk, _, _⟩ := h_props
    have h_rt_in := workload_bound_response_time_of_first_job_inside_interval job_arrival job_cost job_task arr_seq H_jobs_have_valid_parameters sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute tsk t1 delta R_tsk H_response_time_bound num_mid_jobs H_at_least_two_jobs elem
    -- Case split: does job_arrival j_fst + R_tsk < t1 + delta?
    by_cases h_rt_lt : job_arrival j_fst + R_tsk < t1 + delta
    . -- service after RT is 0, so service_during [t1, t1+delta) = service_during [t1, arr+R)
      have h_comp : completed job_cost sched j_fst (job_arrival j_fst + R_tsk) := by
        apply H_response_time_bound j_fst h_arr h_tsk h_rt_lt
      have h_zero := cumulative_service_after_job_rt_zero job_arrival job_cost sched H_completed_jobs_dont_execute j_fst R_tsk h_comp (job_arrival j_fst + R_tsk) (t1 + delta) (le_refl _)
      unfold service_during
      rw [show Finset.Ico t1 (t1 + delta) = Finset.Ico t1 (job_arrival j_fst + R_tsk) ∪ Finset.Ico (job_arrival j_fst + R_tsk) (t1 + delta) from by
        rw [Finset.Ico_union_Ico_eq_Ico (by exact h_rt_in) (by omega)]]
      rw [Finset.sum_union (by exact Finset.Ico_disjoint_Ico (le_refl _))]
      rw [h_zero, Nat.add_zero]
      calc ∑ t ∈ Finset.Ico t1 (job_arrival j_fst + R_tsk), service_at sched j_fst t
          ≤ ∑ _t ∈ Finset.Ico t1 (job_arrival j_fst + R_tsk), 1 :=
            Finset.sum_le_sum (fun i _ => service_at_most_one sched j_fst H_sequential_jobs i)
        _ = (Finset.Ico t1 (job_arrival j_fst + R_tsk)).card := by simp
        _ = job_arrival j_fst + R_tsk - t1 := by rw [Finset.card_Ico]
    . -- t1 + delta ≤ job_arrival j_fst + R_tsk, so [t1, t1+delta) ⊆ [t1, arr+R)
      push_neg at h_rt_lt
      calc service_during sched j_fst t1 (t1 + delta)
          ≤ ∑ _t ∈ Finset.Ico t1 (t1 + delta), 1 := by
            unfold service_during
            exact Finset.sum_le_sum (fun i _ => service_at_most_one sched j_fst H_sequential_jobs i)
        _ = delta := by simp [Finset.card_Ico]
        _ ≤ job_arrival j_fst + R_tsk - t1 := by omega
  -- Bound service of j_lst: service_during sched j_lst t1 (t1+delta) ≤ t1 + delta - job_arrival j_lst
  . have h_lt : num_mid_jobs + 1 < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length := by
      rw [H_at_least_two_jobs]; omega
    have h_lst_mem : j_lst ∈ mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
      unfold_let j_lst; rw [List.getD_eq_getElem (hn := h_lt)]
      exact List.getElem_mem h_lt
    have h_lst_before := workload_bound_last_job_arrives_before_end_of_interval job_arrival job_cost job_task arr_seq H_jobs_have_valid_parameters sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute tsk t1 delta R_tsk H_response_time_bound num_mid_jobs H_at_least_two_jobs elem
    by_cases h_lst_le : job_arrival j_lst ≤ t1
    . -- j_lst arrives before t1, so service is bounded by [arr_lst, t1+delta)
      unfold service_during
      calc ∑ t ∈ Finset.Ico t1 (t1 + delta), service_at sched j_lst t
          ≤ ∑ t ∈ Finset.Ico (job_arrival j_lst) (t1 + delta), service_at sched j_lst t := by
            apply Finset.sum_le_sum_of_subset
            intro x hx; rw [Finset.mem_Ico] at hx ⊢; exact ⟨le_trans h_lst_le hx.1, hx.2⟩
        _ ≤ ∑ _t ∈ Finset.Ico (job_arrival j_lst) (t1 + delta), 1 :=
            Finset.sum_le_sum (fun i _ => service_at_most_one sched j_lst H_sequential_jobs i)
        _ = t1 + delta - job_arrival j_lst := by simp [Finset.card_Ico]
    . -- j_lst arrives after t1
      push_neg at h_lst_le
      unfold service_during
      rw [show Finset.Ico t1 (t1 + delta) = Finset.Ico t1 (job_arrival j_lst) ∪ Finset.Ico (job_arrival j_lst) (t1 + delta) from by
        rw [Finset.Ico_union_Ico_eq_Ico (by omega) (by omega)]]
      rw [Finset.sum_union (by exact Finset.Ico_disjoint_Ico (le_refl _))]
      have h_zero := cumulative_service_before_job_arrival_zero job_arrival sched j_lst H_jobs_must_arrive_to_execute t1 (job_arrival j_lst) (le_refl _)
      rw [h_zero, Nat.zero_add]
      calc ∑ t ∈ Finset.Ico (job_arrival j_lst) (t1 + delta), service_at sched j_lst t
          ≤ ∑ _t ∈ Finset.Ico (job_arrival j_lst) (t1 + delta), 1 :=
            Finset.sum_le_sum (fun i _ => service_at_most_one sched j_lst H_sequential_jobs i)
        _ = t1 + delta - job_arrival j_lst := by simp [Finset.card_Ico]

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks H_valid_task_parameters H_constrained_deadline H_response_time_bound H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_simpl_expression_with_first_and_last
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
    let j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
    job_arrival j_fst + R_tsk - t1 +
      (t1 + delta - job_arrival j_lst) =
    delta + R_tsk -
      (job_arrival j_lst - job_arrival j_fst) := by
  intro j_fst j_lst
  have lemma1 := workload_bound_last_job_arrives_before_end_of_interval job_arrival job_cost job_task arr_seq H_jobs_have_valid_parameters sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute tsk t1 delta R_tsk H_response_time_bound num_mid_jobs H_at_least_two_jobs elem
  have lemma2 := workload_bound_response_time_of_first_job_inside_interval job_arrival job_cost job_task arr_seq H_jobs_have_valid_parameters sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute tsk t1 delta R_tsk H_response_time_bound num_mid_jobs H_at_least_two_jobs elem
  have h_fst_le_lst : job_arrival j_fst <= job_arrival j_lst := by
    apply Prosa.Classic.Util.Sorting.prev_le_next (fun j => job_arrival j)
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta) elem 0 (num_mid_jobs + 1)
    . intro i hi
      have := workload_bound_jobs_ordered_by_arrival job_arrival job_task sched tsk t1 delta i elem hi
      simp [decide_eq_true_eq] at this
      exact this
    . rw [H_at_least_two_jobs]; omega
  omega

theorem workload_bound_service_of_middle_jobs
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    ∑ i ∈ Finset.Ico 0 num_mid_jobs,
      service_during sched
        ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (i + 1) elem)
        t1 (t1 + delta) ≤
      num_mid_jobs * task_cost tsk := by
  calc ∑ i ∈ Finset.Ico 0 num_mid_jobs,
      service_during sched
        ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (i + 1) elem)
        t1 (t1 + delta)
      ≤ ∑ _i ∈ Finset.Ico 0 num_mid_jobs, task_cost tsk := by
        apply Finset.sum_le_sum
        intro i hi
        rw [Finset.mem_Ico] at hi
        have h_idx : i + 1 < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length := by
          rw [H_at_least_two_jobs]; omega
        have h_in : (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (i + 1) elem ∈
            mk_sorted_jobs job_arrival job_task sched tsk t1 delta := by
          rw [List.getD_eq_getElem (hn := h_idx)]
          exact List.getElem_mem h_idx
        have h_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta _ h_in
        obtain ⟨h_arr, h_tsk, _, _⟩ := h_props
        exact cumulative_service_le_task_cost task_cost task_deadline job_cost job_deadline job_task sched
          H_completed_jobs_dont_execute tsk _ h_tsk (H_jobs_have_valid_parameters _ h_arr) t1 (t1 + delta)
    _ = num_mid_jobs * task_cost tsk := by
          rw [Finset.sum_const]
          simp [mul_comm]

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks H_valid_task_parameters H_constrained_deadline H_response_time_bound H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_many_periods_in_between
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
    let j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
    job_arrival j_lst - job_arrival j_fst >= (num_mid_jobs + 1) * task_period tsk := by
  intro j_fst j_lst
  set sorted := mk_sorted_jobs job_arrival job_task sched tsk t1 delta
  -- Use the telescoping sum
  have h_EQnk : num_mid_jobs + 1 = sorted.length - 1 := by rw [H_at_least_two_jobs]; omega
  -- Ordered arrivals
  have h_ord : forall i, i < sorted.length - 1 ->
      job_arrival (sorted.getD i elem) <= job_arrival (sorted.getD (i + 1) elem) := by
    intro i hi
    have := workload_bound_jobs_ordered_by_arrival job_arrival job_task sched tsk t1 delta i elem hi
    simp [decide_eq_true_eq] at this; exact this
  rw [h_EQnk]
  have h_tele := Prosa.Classic.Util.Sum.telescoping_sum (fun j => job_arrival j) sorted elem h_ord
  -- sorted.getD (sorted.length - 1) elem = j_lst
  have h_lst_eq : sorted.getD (sorted.length - 1) elem = j_lst := by
    unfold_let j_lst; congr 1; rw [H_at_least_two_jobs]; omega
  have h_fst_eq : sorted.getD 0 elem = j_fst := by rfl
  rw [h_lst_eq, h_fst_eq] at h_tele
  rw [h_tele]
  -- Now show sum of (arr(i+1) - arr(i)) >= (sorted.length - 1) * task_period tsk
  apply le_trans _ (Finset.sum_le_sum (fun i hi => ?_))
  . rw [Finset.sum_const, Finset.card_Ico, Nat.sub_zero]; exact le_refl _
  . rw [Finset.mem_Ico] at hi
    -- For each consecutive pair, show arr(i+1) - arr(i) >= task_period tsk
    set cur := sorted.getD i elem
    set next := sorted.getD (i + 1) elem
    have h_ord_i := h_ord i (by omega)
    -- Get properties of cur and next
    have h_cur_lt : i < sorted.length := by omega
    have h_next_lt : i + 1 < sorted.length := by omega
    have h_cur_mem : cur ∈ sorted := by
      unfold_let cur; rw [List.getD_eq_getElem (hn := h_cur_lt)]; exact List.getElem_mem h_cur_lt
    have h_next_mem : next ∈ sorted := by
      unfold_let next; rw [List.getD_eq_getElem (hn := h_next_lt)]; exact List.getElem_mem h_next_lt
    have h_cur_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta cur h_cur_mem
    have h_next_props := workload_bound_all_jobs_from_tsk job_arrival job_task arr_seq sched H_jobs_come_from_arrival_sequence tsk t1 delta next h_next_mem
    obtain ⟨h_cur_arr, h_cur_tsk, _, _⟩ := h_cur_props
    obtain ⟨h_next_arr, h_next_tsk, _, _⟩ := h_next_props
    -- cur != next (since sorted is a permutation of a nodup list)
    have h_nodup : sorted.Nodup := by
      unfold_let sorted mk_sorted_jobs
      exact List.Perm.nodup (List.mergeSort_perm _ _).symm (List.Nodup.filter _ (List.nodup_dedup _))
    have h_ne : cur != next := by
      intro h_eq
      unfold_let cur next at h_eq
      rw [List.getD_eq_getElem (hn := h_cur_lt), List.getD_eq_getElem (hn := h_next_lt)] at h_eq
      have := List.Nodup.getElem_ne_getElem h_nodup (by omega : i != i + 1)
      exact this h_eq
    -- Use sporadic task model
    have h_spor := H_sporadic_tasks cur next h_ne h_cur_arr h_next_arr (by rw [h_cur_tsk, h_next_tsk]) h_ord_i
    rw [h_cur_tsk] at h_spor
    omega

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks H_valid_task_parameters H_constrained_deadline H_response_time_bound H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_n_k_covers_middle_jobs
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (_elem : Job) :
    max_jobs task_cost task_period tsk R_tsk delta >= num_mid_jobs := by
  -- By contradiction: assume n_k < num_mid_jobs
  by_contra h_lt
  push_neg at h_lt
  set n_k := max_jobs task_cost task_period tsk R_tsk delta
  -- Need a dummy element
  have h_sz : 0 < (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length := by
    rw [H_at_least_two_jobs]; omega
  obtain ⟨elem, _⟩ : Exists (fun _ : Job => True) := by
    have := List.length_pos.mp h_sz
    exact ⟨(mk_sorted_jobs job_arrival job_task sched tsk t1 delta).head this, trivial⟩
  set j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
  set j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
  -- Extract valid task parameters
  obtain ⟨_, h_period_pos, _, _, h_cost_le_period⟩ := H_valid_task_parameters
  -- DISTmax: job_arrival j_lst - job_arrival j_fst >= delta + task_period tsk
  have h_many := workload_bound_many_periods_in_between job_arrival job_cost job_task arr_seq H_jobs_have_valid_parameters sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks tsk t1 delta R_tsk H_response_time_bound num_mid_jobs H_at_least_two_jobs elem
  have h_fst_le_lst : job_arrival j_fst <= job_arrival j_lst := by
    apply Prosa.Classic.Util.Sorting.prev_le_next (fun j => job_arrival j)
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta) elem 0 (num_mid_jobs + 1)
    . intro i hi
      have := workload_bound_jobs_ordered_by_arrival job_arrival job_task sched tsk t1 delta i elem hi
      simp [decide_eq_true_eq] at this; exact this
    . rw [H_at_least_two_jobs]; omega
  -- n_k + 2 <= num_mid_jobs + 1
  have h_nk_bound : n_k + 2 <= num_mid_jobs + 1 := by omega
  -- (n_k + 2) * task_period tsk <= (num_mid_jobs + 1) * task_period tsk <= j_lst - j_fst
  have h_dist : (n_k + 2) * task_period tsk <= job_arrival j_lst - job_arrival j_fst := by
    calc (n_k + 2) * task_period tsk <= (num_mid_jobs + 1) * task_period tsk := Nat.mul_le_mul_right _ h_nk_bound
      _ <= job_arrival j_lst - job_arrival j_fst := h_many
  -- Also: (n_k + 1) * task_period tsk + task_period tsk = (n_k+2) * task_period tsk
  -- And: delta + R_tsk - task_cost tsk < (n_k + 1) * task_period tsk (by definition of div_floor)
  have h_ceil : delta + R_tsk - task_cost tsk < (n_k + 1) * task_period tsk := by
    unfold_let n_k max_jobs div_floor
    exact Nat.lt_div_add_one_mul_self _ _ h_period_pos
  -- So delta + task_period tsk <= (n_k+2) * task_period tsk
  have h_delta_bound : delta + task_period tsk <= (n_k + 2) * task_period tsk := by
    have : delta + R_tsk - task_cost tsk < (n_k + 1) * task_period tsk := h_ceil
    have : delta <= delta + R_tsk - task_cost tsk := by omega
    nlinarith
  -- Therefore j_lst - j_fst >= delta + task_period tsk
  have h_dist2 : job_arrival j_lst - job_arrival j_fst >= delta + task_period tsk := by omega
  -- Since j_fst + R_tsk >= t1, we have j_lst >= t1 + delta + task_period tsk - R_tsk... 
  -- Actually: j_lst = j_fst + (j_lst - j_fst) >= j_fst + delta + task_period tsk
  -- And j_fst + task_deadline tsk >= j_fst + R_tsk >= t1, so j_fst >= t1 - R_tsk
  -- And j_lst >= j_fst + delta + task_period tsk >= t1 - R_tsk + delta + task_period tsk
  -- With constrained deadline: task_deadline tsk <= task_period tsk
  -- And R_tsk <= task_deadline tsk
  -- So j_lst >= t1 + delta + task_period tsk - R_tsk >= t1 + delta (since task_period >= R_tsk? No...)
  -- Let me follow the Coq proof more carefully
  -- j_lst - j_fst + j_fst >= delta + task_period tsk + j_fst
  -- i.e. j_lst >= j_fst + delta + task_period tsk
  have h_j_lst_bound : job_arrival j_lst >= job_arrival j_fst + delta + task_period tsk := by omega
  -- From response time bound: t1 <= j_fst + R_tsk
  have h_rt_in := workload_bound_response_time_of_first_job_inside_interval job_arrival job_cost job_task arr_seq H_jobs_have_valid_parameters sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute tsk t1 delta R_tsk H_response_time_bound num_mid_jobs H_at_least_two_jobs elem
  -- From last job: j_lst < t1 + delta
  have h_lst_before := workload_bound_last_job_arrives_before_end_of_interval job_arrival job_cost job_task arr_seq H_jobs_have_valid_parameters sched H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute tsk t1 delta R_tsk H_response_time_bound num_mid_jobs H_at_least_two_jobs elem
  -- j_lst >= j_fst + delta + task_period tsk >= (t1 - R_tsk) + delta + task_period tsk
  -- And t1 <= j_fst + R_tsk, so j_fst >= t1 - R_tsk
  -- j_lst >= (t1 - R_tsk) + delta + task_period tsk
  -- But j_lst < t1 + delta
  -- So t1 + delta > (t1 - R_tsk) + delta + task_period tsk = t1 + delta + task_period tsk - R_tsk
  -- i.e. R_tsk > task_period tsk... but we have R_tsk <= task_deadline tsk <= task_period tsk
  -- Actually we need: j_lst >= j_fst + delta + task_period tsk
  -- And t1 <= j_fst + R_tsk, so j_fst >= t1 - R_tsk
  -- j_lst >= t1 - R_tsk + delta + task_period tsk
  -- But j_lst < t1 + delta
  -- So t1 + delta > t1 - R_tsk + delta + task_period tsk
  -- = t1 + delta + task_period tsk - R_tsk  (when R_tsk <= task_period tsk)
  -- This gives R_tsk > task_period tsk, contradiction with R_tsk <= task_deadline tsk <= task_period tsk
  -- 
  -- Wait, we need to be more careful with natural subtraction. Let me use:
  -- t1 <= j_fst + R_tsk (from h_rt_in)
  -- j_lst >= j_fst + delta + task_period tsk  (h_j_lst_bound)
  -- j_lst < t1 + delta  (h_lst_before)
  -- So j_fst + delta + task_period tsk <= j_lst < t1 + delta
  -- j_fst + task_period tsk < t1
  -- But t1 <= j_fst + R_tsk
  -- So j_fst + task_period tsk < j_fst + R_tsk
  -- task_period tsk < R_tsk
  -- But R_tsk <= task_deadline tsk <= task_period tsk, contradiction
  have : task_period tsk < R_tsk := by omega
  have : R_tsk <= task_period tsk := le_trans H_no_deadline_miss H_constrained_deadline
  omega

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks H_valid_task_parameters H_constrained_deadline H_response_time_bound H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_n_k_equals_num_mid_jobs
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
    let j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
    num_mid_jobs = max_jobs task_cost task_period tsk R_tsk delta →
    service_during sched j_lst t1 (t1 + delta) +
      service_during sched j_fst t1 (t1 + delta) +
      ∑ i ∈ Finset.Ico 0 num_mid_jobs,
        service_during sched
          ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (i + 1) elem)
          t1 (t1 + delta) ≤
      W task_cost task_period tsk R_tsk delta := by
  sorry

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks H_valid_task_parameters H_constrained_deadline H_response_time_bound H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bound_n_k_equals_num_mid_jobs_plus_1
    (num_mid_jobs : ℕ)
    (H_at_least_two_jobs :
      (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).length = num_mid_jobs + 2)
    (elem : Job) :
    let j_fst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD 0 elem
    let j_lst := (mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (num_mid_jobs + 1) elem
    num_mid_jobs + 1 = max_jobs task_cost task_period tsk R_tsk delta →
    service_during sched j_lst t1 (t1 + delta) +
      service_during sched j_fst t1 (t1 + delta) +
      ∑ i ∈ Finset.Ico 0 num_mid_jobs,
        service_during sched
          ((mk_sorted_jobs job_arrival job_task sched tsk t1 delta).getD (i + 1) elem)
          t1 (t1 + delta) ≤
      W task_cost task_period tsk R_tsk delta := by
  sorry

include H_jobs_have_valid_parameters H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_sporadic_tasks H_valid_task_parameters H_constrained_deadline H_response_time_bound H_response_time_ge_cost H_no_deadline_miss in
theorem workload_bounded_by_W :
    workload job_task sched tsk t1 (t1 + delta) ≤
      W task_cost task_period tsk R_tsk delta := by
  sorry

end ProofWorkloadBound

end WorkloadBound

end Prosa.Classic.Analysis.Apa.Workload_bound
