theorem any_job_completed_before_period :
    ∀ j,
      arrives_in arr_seq j →
      job_task j = tsk →
      completed_by job_cost sched j (job_arrival j + task_period (job_task j)) := by
  intro j h_arr h_tsk
  obtain ⟨t, h_in⟩ := h_arr
  revert j
  induction t using Nat.strong_rec_on with
  | _ t IHt =>
    intro j h_in h_tsk
    have h_arr : arrives_in arr_seq j := ⟨t, h_in⟩
    -- Show completed_by job_cost sched j (job_arrival j + WCRT ...)
    -- then use completion_monotonic to get completed_by at period
    have h_wcrt_le : WCRT task_cost task_time_slot ts tsk ≤ task_period tsk := WCRT_le_period
    have h_wcrt_le' : job_arrival j + WCRT task_cost task_time_slot ts tsk ≤ job_arrival j + task_period (job_task j) := by
      rw [h_tsk]; omega
    -- Build the valid_job for j
    have h_vjp := H_valid_job_parameters j h_arr
    have h_valid_job : Prosa.Classic.Model.Arrival.Basic.Job.valid_realtime_job job_cost job_deadline j ∧
        job_cost j ≤ task_cost (job_task j) ∧ job_deadline j = task_deadline (job_task j) := by
      exact ⟨⟨h_vjp.1, h_vjp.2.1, h_vjp.2.2.1⟩, h_vjp.2.2.2.1, h_vjp.2.2.2.2⟩
    -- Build all_previous_jobs_of_same_task_completed for j
    have h_prev : ∀ j_other,
        arrives_in arr_seq j_other →
        job_task j = job_task j_other →
        job_arrival j_other < job_arrival j →
        completed_by job_cost sched j_other (job_arrival j) := by
      intro j_other h_arr_other h_same_task h_lt
      have h_neq : j ≠ j_other := by
        intro h_eq; subst h_eq; exact Nat.lt_irrefl _ h_lt
      have h_le : job_arrival j_other ≤ job_arrival j := Nat.le_of_lt h_lt
      have h_period : job_arrival j_other + task_period (job_task j_other) ≤ job_arrival j :=
        H_sporadic_tasks j_other j h_neq.symm h_arr_other h_arr h_same_task.symm h_le
      obtain ⟨t_other, h_in_other⟩ := h_arr_other
      have h_consist_j : job_arrival j = t := H_arrival_times_are_consistent j t h_in
      have h_consist_other : job_arrival j_other = t_other := H_arrival_times_are_consistent j_other t_other h_in_other
      have h_t_lt : t_other < t := by omega
      have h_tsk_other : job_task j_other = tsk := h_same_task.symm ▸ h_tsk
      have h_comp_period : completed_by job_cost sched j_other (job_arrival j_other + task_period (job_task j_other)) :=
        IHt t_other h_t_lt j_other h_in_other h_tsk_other
      exact completion_monotonic job_cost sched j_other
        (job_arrival j_other + task_period (job_task j_other)) (job_arrival j) h_period h_comp_period
    -- Now call job_completed_by_WCRT
    have h_completed_wcrt : completed_by job_cost sched j (job_arrival j + WCRT_fn ts task_cost tsk task_time_slot) :=
      Tdma_wcrt_analysis.WCRT_OneJobTDMA.job_completed_by_WCRT
        task_cost task_period task_deadline job_arrival job_cost job_deadline job_task
        arr_seq H_sporadic_tasks sched H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute
        task_time_slot slot_order ts H_valid_task_parameters tsk H_task_in_task_set
        j h_tsk h_arr h_valid_job H_valid_time_slot TDMA_policy h_prev
        (H_job_cost_le_task_cost j h_arr)
