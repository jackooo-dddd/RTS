    have h_eq : WCRT task_cost task_time_slot ts tsk = WCRT_fn ts task_cost tsk task_time_slot := by
      unfold WCRT WCRT_formula WCRT_fn WCRT_formula_fn
      ring
    rw [h_eq] at h_wcrt_le'
    exact completion_monotonic job_cost sched j
      (job_arrival j + WCRT_fn ts task_cost tsk task_time_slot)
      (job_arrival j + task_period (job_task j)) h_wcrt_le' h_completed_wcrt

