section WCRT_Defs

variable {sporadic_task : Type*} [DecidableEq sporadic_task]
variable (task_cost : sporadic_task → Time)
variable (task_time_slot : TDMA_slot sporadic_task)
variable (ts : SeqSet sporadic_task)
variable (slot_order : TDMA_slot_order sporadic_task)
variable (tsk : sporadic_task)

def WCRT_formula (cycle s wcet : ℕ) : ℕ :=
  (div_ceil wcet s) * (cycle - s) + wcet

def WCRT : ℕ :=
  WCRT_formula (TDMA_cycle ts task_time_slot) (task_time_slot tsk) (task_cost tsk)

private def from_start_of_slot (t : Time) : ℕ :=
  (t + TDMA_cycle ts task_time_slot -
    Task_slot_offset ts slot_order tsk task_time_slot % TDMA_cycle ts task_time_slot) %
  TDMA_cycle ts task_time_slot

private def to_next_slot' (t : Time) : ℕ :=
  TDMA_cycle ts task_time_slot - from_start_of_slot task_time_slot ts slot_order tsk t

private def to_end_of_slot (t : Time) : ℕ :=
  task_time_slot tsk - from_start_of_slot task_time_slot ts slot_order tsk t

private def duration_to_finish_from_start_of_slot_with (c : Duration) : ℕ :=
  (div_ceil c (task_time_slot tsk) - 1) *
    (TDMA_cycle ts task_time_slot - task_time_slot tsk) + c

noncomputable def formula_rt (arr : Instant) (c : Duration) : ℕ :=
  if c = 0 then 0
  else if @decide _ (Classical.dec (Task_in_time_slot ts slot_order tsk task_time_slot arr))
    then
      if c ≤ to_end_of_slot task_time_slot ts slot_order tsk arr then c
      else to_next_slot' task_time_slot ts slot_order tsk arr +
           duration_to_finish_from_start_of_slot_with task_time_slot ts tsk
             (c - to_end_of_slot task_time_slot ts slot_order tsk arr)
  else
    to_next_slot' task_time_slot ts slot_order tsk arr +
    duration_to_finish_from_start_of_slot_with task_time_slot ts tsk c

variable {Job : Type*} [DecidableEq Job]
variable (job_arrival : Job → Time)
variable (job_cost : Job → Time)

noncomputable def job_response_time_tdma_in_at_most_one_job_is_pending
    (j : Job) : ℕ :=
  @formula_rt sporadic_task _ task_time_slot ts slot_order tsk (job_arrival j) (job_cost j)

end WCRT_Defs

