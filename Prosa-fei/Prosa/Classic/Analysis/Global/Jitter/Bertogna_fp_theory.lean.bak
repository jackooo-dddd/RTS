  ∀ j0,
    arrives_in arr_seq j0 →
    job_task j0 = tsk →
    job_arrival j0 < job_arrival j →
    completed job_cost sched j0 (job_arrival j0 + task_jitter tsk + R))

section LemmasAboutHPTasks

variable (tsk_other : sporadic_task)
variable (R_other : Time)
variable (H_response_time_of_tsk_other : (tsk_other, R_other) ∈ hp_bounds)

include H_sporadic_tasks H_valid_job_parameters H_valid_task_parameters
  H_constrained_deadlines H_all_jobs_from_taskset H_jobs_come_from_arrival_sequence
  H_sequential_jobs H_jobs_execute_after_jitter H_completed_jobs_dont_execute
  H_response_time_of_interfering_tasks_is_known H_response_time_bounds_ge_cost
  H_interfering_tasks_miss_no_deadlines H_job_arrives H_job_of_tsk
  H_j_not_completed H_previous_jobs_of_tsk_completed
  H_response_time_of_tsk_other

theorem bertogna_fp_workload_bounds_interference :
    task_interference job_arrival job_cost job_task job_jitter sched j tsk_other
      (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R) ≤
    W_jitter task_cost task_period task_jitter tsk_other R_other R := by
  -- The interference of tsk_other on j is bounded by the workload of tsk_other,
  -- which is in turn bounded by W_jitter.
  -- Step 1: interference ≤ workload
  have h_interf_le_work : task_interference job_arrival job_cost job_task job_jitter sched j tsk_other
      (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R) ≤
      Prosa.Classic.Model.Schedule.Global.Workload.workload job_task sched tsk_other
        (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R) := by
    -- The Lean task_interference in this file uses ScheduleWithJitter.backlogged while
    -- the upstream task_interference_le_workload uses Schedule.backlogged.
    -- Both sums are over Finset.Ico, and the interference ≤ workload because
    -- the backlogged condition only restricts contributions.
    unfold task_interference
    unfold Prosa.Classic.Model.Schedule.Global.Workload.workload
    apply Finset.sum_le_sum
    intro t _
    apply Finset.sum_le_sum
    intro cpu _
    unfold ScheduleOfSporadicTaskWithJitter.task_scheduled_on
      Prosa.Classic.Model.Schedule.Global.Workload.service_of_task
    cases h_sched : sched cpu t with
    | none =>
      simp [ScheduleWithJitter.backlogged]
    | some j' =>
      simp only []
      by_cases h_task : job_task j' = tsk_other
      · simp only [h_task, decide_true, ite_true]
        by_cases h_back : ScheduleWithJitter.backlogged job_arrival job_cost job_jitter sched j t
        · simp [h_back]
        · simp [h_back]
      · simp only [h_task, decide_false, Bool.false_eq_true, ite_false]
        by_cases h_back : ScheduleWithJitter.backlogged job_arrival job_cost job_jitter sched j t
        · simp [h_back]
        · simp [h_back]
  -- Step 2: workload ≤ W_jitter (using workload_bounded_by_W)
  apply le_trans h_interf_le_work
  apply workload_bounded_by_W task_cost task_period task_deadline task_jitter
    job_arrival job_cost job_task job_deadline job_jitter arr_seq
    (fun j' h => H_valid_job_parameters j' h)
    sched H_jobs_come_from_arrival_sequence
    H_jobs_execute_after_jitter H_completed_jobs_dont_execute
    H_sequential_jobs H_sporadic_tasks tsk_other
  · exact (H_valid_task_parameters tsk_other
      (by
        -- tsk_other is in ts because it has a response time bound
        -- We need to show tsk_other ∈ ts.
        -- From H_response_time_of_tsk_other: (tsk_other, R_other) ∈ hp_bounds
        -- The Coq proof establishes tsk_other ∈ ts by finding a job scheduled as tsk_other
        -- and using H_all_jobs_from_taskset.
        -- For now we use sorry since it requires instantiation of scheduling.
        sorry))
  · exact (H_constrained_deadlines tsk_other
      (by sorry))
  · exact H_response_time_bounds_ge_cost tsk_other R_other H_response_time_of_tsk_other
  · exact H_interfering_tasks_miss_no_deadlines tsk_other R_other H_response_time_of_tsk_other
  · intro j' hj' htsk' hlt'
    have := H_response_time_of_interfering_tasks_is_known tsk_other R_other H_response_time_of_tsk_other
    unfold is_response_time_bound_of_task at this
    have hcomp := this j' hj' htsk'
    -- hcomp : completed job_cost sched j' (job_arrival j' + (task_jitter tsk_other + R_other))
    -- We need: completed job_cost sched j' (job_arrival j' + task_jitter tsk_other + R_other)
    rwa [← Nat.add_assoc] at hcomp

end LemmasAboutHPTasks

section DerivingContradiction

include H_sporadic_tasks H_valid_job_parameters H_valid_task_parameters
  H_constrained_deadlines H_all_jobs_from_taskset H_jobs_come_from_arrival_sequence
  H_sequential_jobs H_jobs_execute_after_jitter H_completed_jobs_dont_execute
  H_at_least_one_cpu H_work_conserving H_respects_priority
  task_in_ts H_response_time_of_interfering_tasks_is_known
  H_hp_bounds_has_interfering_tasks H_response_time_bounds_ge_cost
  H_interfering_tasks_miss_no_deadlines H_response_time_recurrence_holds
  H_response_time_no_larger_than_deadline
  H_job_arrives H_job_of_tsk
  H_j_not_completed H_previous_jobs_of_tsk_completed

theorem bertogna_fp_too_much_interference :
    total_interference job_arrival job_cost job_jitter sched j
      (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R) ≥
    R - task_cost tsk + 1 := by
  -- Key idea: at each time step in [t1, t1+R), either j is backlogged (counted in interference)
  -- or j is executing (getting service). Since j doesn't complete, total_service < job_cost j ≤ task_cost tsk.
  -- So total_interference ≥ R - total_service ≥ R - (task_cost tsk - 1) = R - task_cost tsk + 1.
  set t1 := job_arrival j + job_jitter j
  -- The proof requires showing that backlogged + service covers each time step,
  -- and that service < task_cost tsk because j doesn't complete.
  -- This is complex in Lean due to the Finset sum structure.
  sorry

theorem bertogna_fp_interference_by_different_tasks :
    ∀ t j_other,
      job_arrival j + job_jitter j ≤ t ∧ t < job_arrival j + job_jitter j + R →
      arrives_in arr_seq j_other →
      ScheduleWithJitter.backlogged job_arrival job_cost job_jitter sched j t →
      scheduled sched j_other t →
      job_task j_other ≠ tsk := by
  -- Key idea: j is backlogged, so j is not scheduled. If j_other has the same task as j,
  -- then either j_other arrived before j (and completed by the response time bound via IH)
  -- or j_other arrived after j (and can't be pending due to sporadic model).
  -- Either way, j_other can't be scheduled at time t with job_task j_other = tsk.
  sorry

theorem bertogna_fp_all_cpus_are_busy :
    ∀ t,
      job_arrival j + job_jitter j ≤ t ∧ t < job_arrival j + job_jitter j + R →
      ScheduleWithJitter.backlogged job_arrival job_cost job_jitter sched j t →
      ts.countP (fun tsk_other =>
        Prosa.Classic.Model.Schedule.Global.Jitter.Constrained_deadlines.task_is_scheduled
          job_task sched tsk_other t &&
        higher_priority_task higher_eq_priority tsk tsk_other) = num_cpus := by
  sorry -- Relies on platform_fp_cpus_busy_with_interfering_tasks (upstream sorry)

theorem bertogna_fp_interference_on_all_cpus :
    ((ts.filter (fun tsk_other => higher_priority_task higher_eq_priority tsk tsk_other)).map
      (fun tsk_k => task_interference job_arrival job_cost job_task job_jitter sched j tsk_k
        (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R))).sum =
    total_interference job_arrival job_cost job_jitter sched j
      (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R) * num_cpus := by
  sorry -- Complex big operator exchange proof

theorem bertogna_fp_interference_in_non_full_processors :
    ∀ (delta : ℕ),
      let hp_tasks := ts.filter (fun tsk_other => higher_priority_task higher_eq_priority tsk tsk_other)
      let x_val := fun tsk_k => task_interference job_arrival job_cost job_task job_jitter sched j tsk_k
        (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R)
      let num_exceeding := hp_tasks.countP (fun i => decide (x_val i ≥ delta))
      0 < num_exceeding ∧ num_exceeding < num_cpus →
      ((hp_tasks.filter (fun i => decide (x_val i < delta))).map x_val).sum ≥
        delta * (num_cpus - num_exceeding) := by
  sorry -- Complex counting argument about processor occupancy

theorem bertogna_fp_minimum_exceeds_interference :
    ∀ (delta : ℕ),
      let hp_tasks := ts.filter (fun tsk_other => higher_priority_task higher_eq_priority tsk tsk_other)
      let x_val := fun tsk_k => task_interference job_arrival job_cost job_task job_jitter sched j tsk_k
        (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R)
      (hp_tasks.map x_val).sum ≥ delta * num_cpus →
      (hp_tasks.map (fun tsk_k => min (x_val tsk_k) delta)).sum ≥ delta * num_cpus := by
  sorry -- Uses bertogna_fp_interference_in_non_full_processors

theorem bertogna_fp_sum_exceeds_total_interference :
    let x_val := fun tsk_k => task_interference job_arrival job_cost job_task job_jitter sched j tsk_k
        (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R)
    (hp_bounds.map (fun ⟨tsk_k, _R_k⟩ =>
      min (x_val tsk_k) (R - task_cost tsk + 1))).sum >
    total_interference_bound_fp task_cost task_period task_jitter tsk hp_bounds R := by
  sorry -- Uses bertogna_fp_minimum_exceeds_interference, div_floor arithmetic

theorem bertogna_fp_exists_task_that_exceeds_bound :
    let x_val := fun tsk_k => task_interference job_arrival job_cost job_task job_jitter sched j tsk_k
        (job_arrival j + job_jitter j) (job_arrival j + job_jitter j + R)
    ∃ tsk_k R_k,
      (tsk_k, R_k) ∈ hp_bounds ∧
      min (x_val tsk_k) (R - task_cost tsk + 1) >
      min (W_jitter task_cost task_period task_jitter tsk_k R_k R)
          (R - task_cost tsk + 1) := by
  intro x_val
  -- From bertogna_fp_sum_exceeds_total_interference, we know the sum of minima exceeds the bound
  have SUM := @bertogna_fp_sum_exceeds_total_interference _ _ task_cost task_period task_deadline
    task_jitter _ _ job_arrival job_cost job_deadline job_task job_jitter _
    H_sporadic_tasks H_valid_job_parameters ts H_valid_task_parameters H_constrained_deadlines
    H_all_jobs_from_taskset _ sched H_jobs_come_from_arrival_sequence H_sequential_jobs
    H_jobs_execute_after_jitter H_completed_jobs_dont_execute H_at_least_one_cpu higher_eq_priority
    H_work_conserving H_respects_priority tsk task_in_ts hp_bounds
    H_response_time_of_interfering_tasks_is_known H_hp_bounds_has_interfering_tasks
    H_response_time_bounds_ge_cost H_interfering_tasks_miss_no_deadlines R
    H_response_time_recurrence_holds H_response_time_no_larger_than_deadline j H_job_arrives
    H_job_of_tsk H_j_not_completed H_previous_jobs_of_tsk_completed
  -- By contradiction: if no element exceeds, the sum can't exceed
  by_contra h_not
  push_neg at h_not
  have h_le : (hp_bounds.map (fun ⟨tsk_k, _R_k⟩ =>
      min (x_val tsk_k) (R - task_cost tsk + 1))).sum ≤
    total_interference_bound_fp task_cost task_period task_jitter tsk hp_bounds R := by
    unfold total_interference_bound_fp interference_bound_generic
    have : ∀ (p : sporadic_task × Time), p ∈ hp_bounds →
        (fun ⟨tsk_k, _R_k⟩ => min (x_val tsk_k) (R - task_cost tsk + 1)) p ≤
        (fun tsk_R => min (W_jitter task_cost task_period task_jitter tsk_R.1 tsk_R.2 R)
            (R - task_cost tsk + 1)) p := by
      intro ⟨tsk_k, R_k⟩ h_mem
      exact h_not tsk_k R_k h_mem
    exact List.sum_le_sum this
  exact Nat.not_lt.mpr h_le SUM

end DerivingContradiction

end Lemmas

include H_sporadic_tasks H_valid_job_parameters H_valid_task_parameters
  H_constrained_deadlines H_all_jobs_from_taskset H_jobs_come_from_arrival_sequence
  H_sequential_jobs H_jobs_execute_after_jitter H_completed_jobs_dont_execute
  H_at_least_one_cpu H_work_conserving H_respects_priority
  task_in_ts H_response_time_of_interfering_tasks_is_known
  H_hp_bounds_has_interfering_tasks H_response_time_bounds_ge_cost
  H_interfering_tasks_miss_no_deadlines H_response_time_recurrence_holds
  H_response_time_no_larger_than_deadline

theorem bertogna_cirinei_response_time_bound_fp :
    is_response_time_bound_of_task job_arrival job_cost job_task arr_seq sched tsk (task_jitter tsk + R) := by
  unfold is_response_time_bound_of_task
  -- We prove: for all j arriving in arr_seq with job_task j = tsk,
  -- completed job_cost sched j (job_arrival j + (task_jitter tsk + R))
  -- Use strong induction on the absolute deadline (job_arrival j + (task_jitter tsk + R))
  intro j ARRj JOBtsk
  -- Strong induction: we prove the result for all j by strong induction on
  -- job_arrival j + (task_jitter tsk + R)
  suffices h : ∀ n, ∀ j', arrives_in arr_seq j' → job_task j' = tsk →
      job_arrival j' + (task_jitter tsk + R) = n →
      completed job_cost sched j' (job_arrival j' + (task_jitter tsk + R)) by
    exact h _ j ARRj JOBtsk rfl
  intro n
  induction n using Nat.strongRecOn with
  | _ n IH =>
  intro j' ARRj' JOBtsk' Heq
  subst Heq
  -- First, establish that previous jobs of tsk complete (the IH)
  have BEFOREok : ∀ j0,
      arrives_in arr_seq j0 →
      job_task j0 = tsk →
      job_arrival j0 < job_arrival j' →
      completed job_cost sched j0 (job_arrival j0 + task_jitter tsk + R) := by
    intro j0 ARR0 JOB0 LT0
    rw [show job_arrival j0 + task_jitter tsk + R = job_arrival j0 + (task_jitter tsk + R)
        from Nat.add_assoc _ _ _]
    apply IH (job_arrival j0 + (task_jitter tsk + R))
    · exact Nat.add_lt_add_right LT0 _
    · exact ARR0
    · exact JOB0
    · rfl
  -- Now show completion at job_arrival j' + (task_jitter tsk + R)
  -- It suffices to show completion at job_arrival j' + job_jitter j' + R,
  -- then use completion_monotonic
  rw [show job_arrival j' + (task_jitter tsk + R) = job_arrival j' + task_jitter tsk + R
      from (Nat.add_assoc _ _ _).symm]
  apply completion_monotonic job_cost sched j' H_completed_jobs_dont_execute
    (job_arrival j' + job_jitter j' + R)
  · -- job_arrival j' + job_jitter j' + R ≤ job_arrival j' + task_jitter tsk + R
    apply Nat.add_le_add_right
    apply Nat.add_le_add_left
    have hvalid := H_valid_job_parameters j' ARRj'
    unfold valid_sporadic_job_with_jitter job_jitter_leq_task_jitter at hvalid
    rw [JOBtsk'] at hvalid
    exact hvalid.2
  · -- completed job_cost sched j' (job_arrival j' + job_jitter j' + R)
    -- Proof by contradiction
    by_contra NOTCOMP
    -- We derive a contradiction: there exists a task whose interference exceeds its bound
    have EX := @bertogna_fp_exists_task_that_exceeds_bound _ _ task_cost task_period task_deadline
      task_jitter _ _ job_arrival job_cost job_deadline job_task job_jitter _
      H_sporadic_tasks H_valid_job_parameters ts H_valid_task_parameters H_constrained_deadlines
      H_all_jobs_from_taskset _ sched H_jobs_come_from_arrival_sequence H_sequential_jobs
      H_jobs_execute_after_jitter H_completed_jobs_dont_execute H_at_least_one_cpu higher_eq_priority
      H_work_conserving H_respects_priority tsk task_in_ts hp_bounds
      H_response_time_of_interfering_tasks_is_known H_hp_bounds_has_interfering_tasks
      H_response_time_bounds_ge_cost H_interfering_tasks_miss_no_deadlines R
      H_response_time_recurrence_holds H_response_time_no_larger_than_deadline j' ARRj'
      JOBtsk' NOTCOMP BEFOREok
    obtain ⟨tsk_k, R_k, HPk, LTmin⟩ := EX
    -- But workload bounds interference: x tsk_k ≤ W_jitter tsk_k R_k R
    have WORKLOAD := bertogna_fp_workload_bounds_interference task_cost task_period task_deadline
      task_jitter job_arrival job_cost job_deadline job_task job_jitter
      H_sporadic_tasks H_valid_job_parameters ts H_valid_task_parameters H_constrained_deadlines
      H_all_jobs_from_taskset sched H_jobs_come_from_arrival_sequence H_sequential_jobs
      H_jobs_execute_after_jitter H_completed_jobs_dont_execute tsk hp_bounds
      H_response_time_of_interfering_tasks_is_known H_response_time_bounds_ge_cost
      H_interfering_tasks_miss_no_deadlines R j' ARRj' JOBtsk' NOTCOMP BEFOREok
      tsk_k R_k HPk
    -- WORKLOAD: x tsk_k ≤ W_jitter tsk_k R_k R
    -- LTmin: min (x tsk_k) (R - task_cost tsk + 1) > min (W_jitter tsk_k R_k R) (R - task_cost tsk + 1)
    -- This contradicts WORKLOAD because min is monotone in the first argument
    have h_min_le : min (task_interference job_arrival job_cost job_task job_jitter sched j' tsk_k
          (job_arrival j' + job_jitter j') (job_arrival j' + job_jitter j' + R))
        (R - task_cost tsk + 1) ≤
      min (W_jitter task_cost task_period task_jitter tsk_k R_k R)
        (R - task_cost tsk + 1) := by
      exact min_le_min_right _ WORKLOAD
    exact Nat.not_lt.mpr h_min_le LTmin

end ResponseTimeBound

end ResponseTimeAnalysisFP

end Prosa.Classic.Analysis.Global.Jitter.Bertogna_fp_theory
