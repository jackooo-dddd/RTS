namespace Prosa.Classic.Implementation.Apa.Arrival_sequence

namespace ConcreteArrivalSequence

open Prosa.Classic.Model.Time
open Prosa.Classic.Model.Arrival.Basic.Arrival_sequence
open Prosa.Classic.Model.Arrival.Basic.Job hiding arrival_sequence arrives_in
open Prosa.Classic.Model.Arrival.Basic.Task.SporadicTask
