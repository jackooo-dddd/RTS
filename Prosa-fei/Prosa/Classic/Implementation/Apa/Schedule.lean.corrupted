  arrives_in arr_seq j â†?backlogged job_arrival job_cost sched_p j t â†?  scheduled_on sched_p j_hp cpu t = true â†?can_execute_on alpha (job_task j) cpu â†?  higher_eq_priority t j_hp j = true
