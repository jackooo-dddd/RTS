    j âˆ?l â†?List.IsChain (fun a b => higher_eq_priority t a b = true) l â†?l.Nodup â†?    (âˆ€ (cpu' : processor num_cpus), (cpu', some j) âˆ?schedule_jobs_from_list job_task alpha higher_eq_priority t l) â†?    can_execute_on alpha (job_task j) cpu â†?    âˆ?j_other : Job, (cpu, some j_other) âˆ?schedule_jobs_from_list job_task alpha higher_eq_priority t l := by sorry

