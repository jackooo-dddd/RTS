namespace BusyInterval

section Defs

variable {Task : Type*} [DecidableEq Task]
variable {Job : Type*} [DecidableEq Job]
variable (job_arrival : Job -> Time)
variable (job_cost : Job -> Time)
variable (job_jitter : Job -> Time)
variable (job_task : Job -> Task)

variable (arr_seq : arrival_sequence Job)
variable (H_arrival_times_are_consistent : arrival_times_are_consistent job_arrival arr_seq)

variable (sched : schedule Job)
variable (H_jobs_come_from_arrival_sequence : jobs_come_from_arrival_sequence sched arr_seq)

variable (higher_eq_priority : JLFP_policy Job)

variable (j : Job)
variable (H_from_arrival_sequence : arrives_in arr_seq j)

def quiet_time (t : Time) : Prop :=
  forall j_hp,
    arrives_in arr_seq j_hp ->
    higher_eq_priority j_hp j = true ->
    actual_arrival_before job_arrival job_jitter j_hp t ->
    completed_by job_cost sched j_hp t

def busy_interval_prefix (t1 t_busy : Time) : Prop :=
  t1 < t_busy
  ∧ quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t1
  ∧ (forall t, t1 < t ∧ t < t_busy ->
    Not (quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t))

def busy_interval (t1 t2 : Time) : Prop :=
  busy_interval_prefix job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t1 t2
  ∧ quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t2

section Lemmas

section BasicLemmas

variable (H_priority_is_reflexive : JLFP_is_reflexive higher_eq_priority)
variable (t1 t2 : Time)
variable (H_busy_interval : busy_interval job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t1 t2)
variable (t : Time)
variable (H_during_interval : t1 <= t ∧ t < t2)
variable (H_job_is_pending :
  Prosa.Classic.Model.Schedule.Uni.Jitter.Schedule.pending job_arrival job_cost job_jitter sched j t)

section CompletesDuringBusyInterval

theorem job_completes_within_busy_interval :
    completed_by job_cost sched j t2 := by
  obtain ⟨_, QUIET⟩ := H_busy_interval
  obtain ⟨_, LT2⟩ := H_during_interval
  apply QUIET
  · exact H_from_arrival_sequence
  · exact H_priority_is_reflexive j
  · unfold actual_arrival_before actual_arrival
    obtain ⟨ARR, _⟩ := H_job_is_pending
    unfold Prosa.Classic.Model.Schedule.Uni.Jitter.Schedule.pending jitter_has_passed actual_arrival at ARR
    simp only [Time] at *; omega

end CompletesDuringBusyInterval

section ArrivesDuringBusyInterval

variable (H_completed_jobs_dont_execute : completed_jobs_dont_execute job_cost sched)

theorem job_arrives_within_busy_interval :
    t1 <= actual_arrival job_arrival job_jitter j := by
  by_contra LT1
  push_neg at LT1
  -- Extract quiet_time t1 from busy_interval
  obtain ⟨⟨_, QUIET, _⟩, _⟩ := H_busy_interval
  -- j is pending at t: jitter_has_passed and not completed
  obtain ⟨_, NOTCOMP⟩ := H_job_is_pending
  obtain ⟨LE, _⟩ := H_during_interval
  -- quiet_time t1 says j is completed by t1
  have COMP := QUIET j H_from_arrival_sequence (H_priority_is_reflexive j) LT1
  -- completion_monotonic gives completed_by j t
  have COMP' := completion_monotonic job_cost sched j t1 t LE COMP
  exact NOTCOMP COMP’

end ArrivesDuringBusyInterval

end BasicLemmas

section ExistsPendingJob

variable (H_completed_jobs_dont_execute : completed_jobs_dont_execute job_cost sched)
variable (t1 t2 : Time)
variable (H_interval : t1 <= t2)
variable (H_quiet : quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t1)
variable (H_not_quiet : Not (quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t2))

theorem not_quiet_implies_exists_pending_job :
    exists j_hp,
      arrives_in arr_seq j_hp ∧
      actual_arrival_between job_arrival job_jitter j_hp t1 t2 ∧
      higher_eq_priority j_hp j = true ∧
      Not (completed_by job_cost sched j_hp t2) := by
  -- H_not_quiet: not quiet_time t2
  -- This means there exists j_hp that arrives_in, has higher_eq_priority, actual_arrival_before t2, but not completed_by t2
  by_contra h_all_done
  push_neg at h_all_done
  apply H_not_quiet
  -- We need to show quiet_time t2
  intro j_hp IN HP ARR
  -- ARR: actual_arrival_before j_hp t2, i.e., actual_arrival j_hp < t2
  unfold actual_arrival_before at ARR
  -- Case split: actual_arrival j_hp < t1 or t1 <= actual_arrival j_hp
  by_cases BEFORE : actual_arrival job_arrival job_jitter j_hp < t1
  · -- j_hp arrived before t1, so quiet_time t1 gives completed_by j_hp t1
    have COMP1 := H_quiet j_hp IN HP BEFORE
    exact completion_monotonic job_cost sched j_hp t1 t2 H_interval COMP1
  · -- t1 <= actual_arrival j_hp < t2
    push_neg at BEFORE
    -- j_hp has actual_arrival_between t1 t2
    have BETWEEN : actual_arrival_between job_arrival job_jitter j_hp t1 t2 :=
      ⟨BEFORE, ARR⟩
    -- So j_hp is in actual_arrivals_between
    have IN_AA := arrived_between_implies_in_actual_arrivals job_arrival job_jitter arr_seq
      H_arrival_times_are_consistent j_hp t1 t2 IN BETWEEN
    -- From h_all_done, for all such j_hp, if they arrive_in and have the properties, they are completed
    -- But h_all_done says: for all j_hp, NOT (arrives_in /\ between /\ hp /\ not completed)
    -- i.e., for all j_hp, arrives_in -> between -> hp -> completed
    have h := h_all_done j_hp
    -- h : ¬(arrives_in arr_seq j_hp ∧ actual_arrival_between ... ∧ higher_eq_priority j_hp j = true ∧ ¬completed_by ...)
    -- Push the negation through
    simp only [not_and] at h
    by_contra NOTCOMP
    exact h IN BETWEEN HP NOTCOMP

end ExistsPendingJob

section ProcessorAlwaysBusy

variable (H_work_conserving : work_conserving job_arrival job_cost job_jitter arr_seq sched)
variable (H_completed_jobs_dont_execute : completed_jobs_dont_execute job_cost sched)
variable (H_jobs_execute_after_jitter : jobs_execute_after_jitter job_arrival job_jitter sched)
variable (t1 t2 : Time)
variable (H_strictly_larger : t1 < t2)
variable (H_quiet : quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t1)
variable (H_not_quiet : forall t, t1 < t ∧ t <= t2 ->
  Not (quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t))

theorem not_quiet_implies_not_idle :
    forall t, t1 <= t ∧ t <= t2 ->
      Not (is_idle sched t = true) := by
  intro t₀ ⟨GEt, LEt⟩ IDLE
  -- Case: t₀ = t1 or t₀ > t1
  by_cases EQUAL : t₀ = t1
  · -- Case t₀ = t1
    subst EQUAL
    -- Show not quiet at t1 + 1
    have NQ := H_not_quiet (t1 + 1) ⟨Nat.lt_succ_of_le (le_refl t1), LEt⟩
    apply NQ
    -- Show quiet_time (t1 + 1)
    intro j_hp IN HP ARR
    -- ARR: actual_arrival j_hp < t1 + 1, so actual_arrival j_hp <= t1
    unfold actual_arrival_before at ARR
    -- So actual_arrival j_hp < t1 or actual_arrival j_hp = t1
    -- In either case, actual_arrival j_hp <= t1 so actual_arrival_before j_hp (t1 + 1)
    -- We want completed_by j_hp (t1 + 1)
    -- Try: if j_hp is completed by t1, then monotonicity gives completed_by at t1+1
    -- If j_hp is not completed by t1, then it's pending (backlogged) at t1
    -- work_conserving says some job is scheduled at t1, but sched is idle -> contradiction
    apply completion_monotonic job_cost sched j_hp t1 (t1 + 1) (Nat.le_succ t1)
    -- Need: completed_by j_hp t1
    -- If not completed, then j_hp is pending at t1 -> backlogged (since idle) -> work_conserving gives scheduled job -> contradiction with idle
    by_contra NOTCOMP
    -- j_hp is backlogged at t1
    have BACK : Prosa.Classic.Model.Schedule.Uni.Jitter.Schedule.backlogged job_arrival job_cost job_jitter sched j_hp t1 := by
      constructor
      · constructor
        · -- jitter_has_passed
          unfold jitter_has_passed actual_arrival
          simp only [Time] at *; omega
        · exact NOTCOMP
      · -- not scheduled: since idle
        simp only [is_idle] at IDLE
        rw [beq_iff_eq] at IDLE
        simp only [scheduled_at, IDLE]
        simp [Bool.toNat]
    have ⟨j_other, SCHED_other⟩ := H_work_conserving j_hp t1 IN BACK
    -- But sched t1 = none (idle), so scheduled_at j_other t1 = false
    simp only [is_idle] at IDLE
    rw [beq_iff_eq] at IDLE
    simp only [scheduled_at, IDLE] at SCHED_other
    simp at SCHED_other
  · -- Case t₀ > t1
    have LARGER : t1 < t₀ := by omega
    have NQ := H_not_quiet t₀ ⟨LARGER, LEt⟩
    apply NQ
    -- Show quiet_time t₀
    intro j_hp IN HP ARR
    -- If j_hp is not completed by t₀, it’s backlogged at t₀ -> work_conserving -> some job scheduled -> contradiction with idle
    by_contra NOTCOMP
    have BACK : Prosa.Classic.Model.Schedule.Uni.Jitter.Schedule.backlogged job_arrival job_cost job_jitter sched j_hp t₀ := by
      constructor
      · constructor
        · unfold jitter_has_passed actual_arrival
          unfold actual_arrival_before at ARR
          simp only [Time] at *; omega
        · exact NOTCOMP
      · simp only [is_idle] at IDLE
        rw [beq_iff_eq] at IDLE
        simp only [scheduled_at, IDLE]
        simp [Bool.toNat]
    have ⟨j_other, SCHED_other⟩ := H_work_conserving j_hp t₀ IN BACK
    simp only [is_idle] at IDLE
    rw [beq_iff_eq] at IDLE
    simp only [scheduled_at, IDLE] at SCHED_other
    simp at SCHED_other

section OnlyHigherOrEqualPriority

variable (H_priority_is_transitive : JLFP_is_transitive higher_eq_priority)
variable (H_respects_policy :
  respects_JLFP_policy job_arrival job_cost job_jitter arr_seq sched higher_eq_priority)

theorem not_quiet_implies_exists_scheduled_hp_job :
    forall t, t1 <= t ∧ t < t2 ->
      exists j_hp,
        actual_arrival_between job_arrival job_jitter j_hp t1 t2 ∧
        higher_eq_priority j_hp j = true ∧
        scheduled_at sched j_hp t = true := by sorry

end OnlyHigherOrEqualPriority

end ProcessorAlwaysBusy

section BoundingBusyInterval

variable (H_arrival_sequence_is_a_set : arrival_sequence_is_a_set arr_seq)
variable (H_jobs_execute_after_jitter : jobs_execute_after_jitter job_arrival job_jitter sched)
variable (H_completed_jobs_dont_execute : completed_jobs_dont_execute job_cost sched)
variable (H_work_conserving : work_conserving job_arrival job_cost job_jitter arr_seq sched)
variable (H_respects_policy :
  respects_JLFP_policy job_arrival job_cost job_jitter arr_seq sched higher_eq_priority)
variable (H_priority_is_reflexive : JLFP_is_reflexive higher_eq_priority)
variable (H_priority_is_transitive : JLFP_is_transitive higher_eq_priority)

section BoundingBusyInterval_inner

variable (t_busy : Time)
variable (H_j_is_pending :
  Prosa.Classic.Model.Schedule.Uni.Jitter.Schedule.pending job_arrival job_cost job_jitter sched j t_busy)

section LowerBound

theorem exists_busy_interval_prefix :
    exists t1,
      busy_interval_prefix job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j
        t1 (t_busy + 1)
      ∧ t1 <= actual_arrival job_arrival job_jitter j
      ∧ actual_arrival job_arrival job_jitter j <= t_busy := by sorry

end LowerBound

section UpperBound

variable (t1 : Time)
variable (H_is_busy_prefix :
  busy_interval_prefix job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j
    t1 (t_busy + 1))
variable (H_busy_prefix_contains_arrival : actual_arrival job_arrival job_jitter j >= t1)
variable (delta : Time)
variable (H_delta_positive : delta > 0)
variable (H_workload_is_bounded :
  workload_of_higher_or_equal_priority_jobs job_cost
    (actual_arrivals_between job_arrival job_jitter arr_seq t1 (t1 + delta))
    higher_eq_priority j <= delta)

section CannotBeBusyForSoLong

variable (H_no_quiet_time :
  forall t, t1 < t ∧ t <= t1 + delta ->
    Not (quiet_time job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t))

theorem busy_interval_has_uninterrupted_service :
    service_of_higher_or_equal_priority_jobs sched
      (actual_arrivals_between job_arrival job_jitter arr_seq t1 (t1 + delta))
      higher_eq_priority j t1 (t1 + delta) = delta := by sorry

theorem busy_interval_too_much_workload :
    workload_of_higher_or_equal_priority_jobs job_cost
      (actual_arrivals_between job_arrival job_jitter arr_seq t1 (t1 + delta))
      higher_eq_priority j >
    service_of_higher_or_equal_priority_jobs sched
      (actual_arrivals_between job_arrival job_jitter arr_seq t1 (t1 + delta))
      higher_eq_priority j t1 (t1 + delta) := by sorry

theorem busy_interval_workload_larger_than_interval :
    workload_of_higher_or_equal_priority_jobs job_cost
      (actual_arrivals_between job_arrival job_jitter arr_seq t1 (t1 + delta))
      higher_eq_priority j > delta := by sorry

end CannotBeBusyForSoLong

theorem busy_interval_is_bounded :
    exists t2,
      t2 <= t1 + delta
      ∧ busy_interval job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t1 t2 := by sorry

end UpperBound

end BoundingBusyInterval_inner

section BusyIntervalFromWorkloadBound

variable (delta : Time)
variable (H_delta_positive : delta > 0)
variable (H_workload_is_bounded :
  forall t, workload_of_higher_or_equal_priority_jobs job_cost
    (actual_arrivals_between job_arrival job_jitter arr_seq t (t + delta))
    higher_eq_priority j <= delta)
variable (H_positive_cost : job_cost j > 0)

theorem exists_busy_interval :
    exists t1 t2,
      t1 <= actual_arrival job_arrival job_jitter j
      ∧ actual_arrival job_arrival job_jitter j < t2
      ∧ t2 <= t1 + delta
      ∧ busy_interval job_arrival job_cost job_jitter arr_seq sched higher_eq_priority j t1 t2 := by sorry

end BusyIntervalFromWorkloadBound

section ResponseTimeBoundFromBusyInterval

variable (delta : Time)
variable (H_delta_positive : delta > 0)
variable (H_workload_is_bounded :
  forall t,
    workload_of_higher_or_equal_priority_jobs job_cost
      (actual_arrivals_between job_arrival job_jitter arr_seq t (t + delta))
      higher_eq_priority j <= delta)

theorem busy_interval_bounds_response_time :
    completed_by job_cost sched j (actual_arrival job_arrival job_jitter j + delta) := by sorry

end ResponseTimeBoundFromBusyInterval

end BoundingBusyInterval

end Lemmas

end Defs

end BusyInterval

end Prosa.Classic.Model.Schedule.Uni.Jitter.Busy_interval
