section BoundOfCumulativeJobInterference

variable (j : Job)
variable (H_j_arrives : arrives_in arr_seq j)
variable (H_job_of_tsk : job_task j = tsk)
variable (H_job_cost_positive : job_cost_positive job_cost j)

variable (t1 t2 : Time)
variable (H_busy_interval :
  busy_interval job_arrival job_cost sched interference interfering_workload j t1 t2)

variable (x : Time)
variable (H_inside_busy_interval : t1 + x < t2)
variable (H_job_j_is_not_completed : ¬ completed_by job_cost sched j (t1 + x))

include H_work_conserving H_j_arrives H_job_of_tsk H_job_cost_positive
  H_busy_interval H_inside_busy_interval H_job_j_is_not_completed
  H_arrival_times_are_consistent H_arr_seq_is_a_set
  H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute in
theorem bound_for_cumulative_job_interference_actual :
    cumul_interference interference j t1 (t1 + x) ≤
    (task_workload_between job_cost job_task arr_seq tsk t1 (t1 + (job_arrival j - t1) + ε) - job_cost j) +
    cumul_task_interference job_task arr_seq sched interference tsk t2 t1 (t1 + x) := by
  sorry

include H_family_of_proper_arrival_curves H_tsk_in_ts
  H_j_arrives H_job_of_tsk H_job_cost_positive
  H_busy_interval H_job_cost_le_task_cost
  H_arrival_times_are_consistent H_arr_seq_is_a_set in
theorem task_rbf_excl_tsk_bounds_task_workload_excl_j :
    task_workload_between job_cost job_task arr_seq tsk t1 (t1 + (job_arrival j - t1) + ε) - job_cost j ≤
    task_request_bound_function task_cost max_arrivals tsk ((job_arrival j - t1) + ε) - task_cost tsk := by
  sorry

include H_work_conserving H_family_of_proper_arrival_curves H_tsk_in_ts
  H_j_arrives H_job_of_tsk H_job_cost_positive
  H_busy_interval H_inside_busy_interval H_job_j_is_not_completed
  H_job_cost_le_task_cost
  H_arrival_times_are_consistent H_arr_seq_is_a_set
  H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute in
theorem bound_for_cumulative_job_interference :
    cumul_interference interference j t1 (t1 + x) ≤
    (task_request_bound_function task_cost max_arrivals tsk ((job_arrival j - t1) + ε) - task_cost tsk) +
    cumul_task_interference job_task arr_seq sched interference tsk t2 t1 (t1 + x) := by
  sorry

end BoundOfCumulativeJobInterference

section MaxInSeqHypothesisImpMaxInNonseqHypothesis

variable (j : Job)
variable (H_j_arrives : arrives_in arr_seq j)
variable (H_job_of_tsk : job_task j = tsk)

include H_proper_job_lock_in_service H_proper_task_lock_in_service
  H_R_is_maximum_seq in
theorem max_in_seq_hypothesis_implies_max_in_nonseq_hypothesis :
    forall A,
      is_in_search_space tsk L
        (total_interference_bound_val task_cost max_arrivals task_interference_bound_function) A ->
      exists F,
        A + F = task_lock_in_service tsk +
                (task_request_bound_function task_cost max_arrivals tsk (A + ε) - task_cost tsk +
                 task_interference_bound_function tsk A (A + F)) /        F + (task_cost tsk - task_lock_in_service tsk) ≤ R := by
  sorry

end MaxInSeqHypothesisImpMaxInNonseqHypothesis

