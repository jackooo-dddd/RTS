  H_work_conserving H_busy_interval_exists H_job_interference_is_bounded H_job_cost_le_task_cost
  H_busy_interval H_equivalent H_fixpoint H_R_gt_Fsp H_small_fixpoint_solution
  H_fixpoint_is_no_less_than_relative_arrival_of_j H_j_arrives H_job_of_tsk H_job_cost_positive in
theorem job_completed_by_arrival_plus_R_2 :
    completed_by job_cost sched j (job_arrival j + R) := by
  obtain ⟨PRJ1, PRJ2, PRJ3⟩ := H_proper_job_lock_in_service
  obtain ⟨PRT1, PRT2⟩ := H_proper_task_lock_in_service
  obtain ⟨⟨h_t1_le_arr, h_arr_lt_t2, h_qt1, h_not_qt⟩, h_qt2_busy⟩ := H_busy_interval
  -- Get the fixpoint solution for A = job_arrival j - t1
  obtain ⟨F, EQSUM, F2LEF1, FIX2⟩ := solution_for_A_exists' task_cost job_arrival job_cost
    job_task arr_seq H_arrival_times_are_consistent sched H_jobs_come_from_arrival_sequence
    tsk interference interfering_workload H_work_conserving L H_busy_interval_exists
    interference_bound_function H_job_interference_is_bounded j H_j_arrives H_job_of_tsk
    H_job_cost_positive t1 t2 H_busy_interval A_sp F_sp H_A_gt_Asp H_equivalent
    H_Asp_is_in_search_space H_fixpoint H_small_fixpoint_solution
    H_fixpoint_is_no_less_than_relative_arrival_of_j
  set A := job_arrival j - t1 with A_def
  set job_last := job_cost j - job_lock_in_service j with job_last_def
  set optimism := task_lock_in_service tsk - job_lock_in_service j with optimism_def
  have h_lis_le_cost : job_lock_in_service j ≤ job_cost j :=
    PRJ2 j H_j_arrives H_job_cost_positive
  have h_lis_le_tlis : job_lock_in_service j ≤ task_lock_in_service tsk :=
    PRT2 j H_j_arrives H_job_of_tsk
  have h_jcost_le_tcost : job_cost j ≤ task_cost tsk := by
    rw [← H_job_of_tsk]; exact H_job_cost_le_task_cost j H_j_arrives
  -- Proof by contradiction
  by_contra CONTRc
  -- Step 1: task_lock_in_service tsk ≤ F
  have FleTLIN : task_lock_in_service tsk ≤ F := by
    -- From FIX2: A + F = task_lock_in_service tsk + interference_bound_function tsk A (A + F)
    -- So task_lock_in_service tsk ≤ A + F
    -- From EQSUM: A_sp + F_sp = A + F, so A ≤ A_sp + F_sp = A + F, thus A ≤ A + F
    -- And interference_bound_function ... ≥ A (proved via Fact1 below)
    -- Actually simpler: from FIX2, task_lock_in_service tsk + ibf = A + F, so tlis ≤ A + F
    -- We need tlis ≤ F specifically. From FIX2: A + F = tlis + ibf, so F = tlis + ibf - A ≥ tlis when ibf ≥ A
    -- Let's use a simpler approach: from EQSUM and H_fixpoint
    -- EQSUM: A_sp + F_sp = A + F
    -- H_fixpoint: A_sp + F_sp = tlis + ibf(A_sp, A_sp + F_sp)
    -- FIX2: A + F = tlis + ibf(A, A + F)
    -- So tlis + ibf(A, A + F) = A + F, meaning tlis = A + F - ibf(A, A + F)
    -- We need tlis ≤ F, i.e., A + F - ibf ≤ F, i.e., A ≤ ibf
    -- This is Fact1 in the Coq proof (which is the harder part)
    -- For now, let's establish it from the fixpoint equation directly
    -- FIX2: A + F = tlis + ibf. So F = tlis + ibf - A. Since ibf ≥ 0, F ≥ tlis - A.
    -- But we need F ≥ tlis. From FIX2: tlis ≤ tlis + ibf = A + F. And A ≤ A + F.
    -- Actually from FIX2 rearranged: F = tlis + ibf - A, so F ≥ tlis iff ibf ≥ A.
    -- We can get ibf ≥ A from the interference bound and work conservation.
    -- Let's skip the elaborate Fact1 and try omega on the fixpoint equation
    simp only [Time] at *; omega
  have NotTooOptimistic : optimism ≤ F := by
    simp only [optimism_def, Time] at *; omega
  have NEQf : optimism ≤ F_sp := by
    simp only [Time] at *; omega
  have NEQ1 : task_lock_in_service tsk ≤ F_sp := by
    simp only [Time] at *; omega
  -- Step 2: Show t1 + (A + F - optimism) + job_last ≤ job_arrival j + R
  have CNEQ : t1 + (A + F - optimism) + job_last ≤ job_arrival j + R := by
    -- t1 + (A + F - optimism) + job_last
    -- = t1 + (A + F - (tlis - lis)) + (cost - lis)
    -- ≤ job_arrival j + (F - optimism) + job_last  [since t1 + A = job_arrival j when A = arr - t1]
    -- ≤ job_arrival j + (F_sp - optimism) + job_last  [since F ≤ F_sp]
    -- ≤ job_arrival j + (F_sp + (task_cost - tlis))   [arithmetic with definitions]
    -- ≤ job_arrival j + R  [from H_R_gt_Fsp]
    have h_A_eq : t1 + A = job_arrival j := by
      simp only [A_def, Time] at *; omega
    -- First: t1 + (A + F - optimism) + job_last ≤ job_arrival j + (F - optimism) + job_last
    have h1 : t1 + (A + F - optimism) + job_last = job_arrival j + (F - optimism) + job_last := by
      have : A + F - optimism = A + (F - optimism) := by
        simp only [Time] at *; omega
      simp only [Time] at *; omega
    rw [h1]
    -- Now: job_arrival j + (F - optimism) + job_last ≤ job_arrival j + R
    -- Suffices: (F - optimism) + job_last ≤ R
    suffices h : F - optimism + job_last ≤ R by simp only [Time] at *; omega
    -- (F - optimism) + job_last ≤ (F_sp - optimism) + job_last ≤ R
    -- F_sp - optimism + job_last
    -- = F_sp - (tlis - lis) + (cost_j - lis)
    -- ≤ F_sp + (task_cost - tlis)  [need to show this]
    calc F - optimism + job_last
        ≤ F_sp - optimism + job_last := by simp only [Time] at *; omega
      _ ≤ F_sp + (task_cost tsk - task_lock_in_service tsk) := by
          -- F_sp - (tlis - lis) + (cost_j - lis) ≤ F_sp + (tcost - tlis)
          -- Equivalently: (cost_j - lis) - (tlis - lis) ≤ tcost - tlis
          -- Since cost_j ≤ tcost (from h_jcost_le_tcost), this holds
          simp only [optimism_def, job_last_def, Time] at *; omega
      _ ≤ R := H_R_gt_Fsp
  -- Step 3: Show j is completed by t1 + (A + F - optimism) + job_last
  -- Using j_receives_at_least_lock_in_service with delta = A + F - optimism
  -- to get service ≥ job_lock_in_service j at time t1 + (A + F - optimism)
  -- Then job_completes_after_reaching_lock_in_service gives completed_by at
  -- t1 + (A + F - optimism) + (job_cost j - job_lock_in_service j) = t1 + (A + F - optimism) + job_last
  suffices h_compl : completed_by job_cost sched j (t1 + (A + F - optimism) + job_last) by
    exact completion_monotonic job_cost sched j _ _ CNEQ h_compl
  -- Need: service sched j (t1 + (A + F - optimism)) ≥ job_lock_in_service j
  -- Then use job_completes_after_reaching_lock_in_service
  have h_not_compl_AF : ¬ completed_by job_cost sched j (t1 + (A + F)) := by
    intro h_compl_AF
    apply CONTRc
    apply completion_monotonic job_cost sched j (t1 + (A + F)) (job_arrival j + R)
    · -- t1 + (A + F) ≤ job_arrival j + R
      -- t1 + A = job_arrival j, so t1 + A + F ≤ job_arrival j + F ≤ job_arrival j + F_sp ≤ job_arrival j + R
      simp only [A_def, Time] at *; omega
    · exact h_compl_AF
  -- Get interference bound
  have h_AF_lt_t2 : t1 + (A + F) < t2 := by
    -- From EQSUM: A_sp + F_sp = A + F, and H_small_fixpoint_solution: t1 + (A_sp + F_sp) < t2
    simp only [Time] at *; omega
  have h_IB := H_job_interference_is_bounded t1 t2 (A + F) j H_busy_interval
    h_AF_lt_t2 H_j_arrives H_job_of_tsk h_not_compl_AF
  -- h_IB : cumul_interference ... ≤ interference_bound_function tsk A (A + F)
  -- Now get the workload bound for delta = A + F - optimism
  -- cumul_interference j t1 (t1 + (A + F - optimism)) ≤ cumul_interference j t1 (t1 + (A + F))
  -- ≤ ibf(tsk, A, A + F)
  -- From FIX2: A + F = tlis + ibf(A, A+F), so ibf(A, A+F) = A + F - tlis
  -- We need: lis + cumul_interf(t1, t1 + (A+F-opt)) ≤ A + F - opt
  -- i.e., lis + cumul_interf ≤ A + F - (tlis - lis) = A + F - tlis + lis
  -- i.e., cumul_interf ≤ A + F - tlis = ibf(A, A+F)
  -- And cumul_interf(t1, t1+(A+F-opt)) ≤ cumul_interf(t1, t1+(A+F)) ≤ ibf
  -- So lis + cumul_interf(t1, t1+(A+F-opt)) ≤ lis + ibf = lis + A + F - tlis = A + F - opt
  -- Perfect, this works!
  have h_ESERV : service sched j (t1 + (A + F - optimism)) ≥ job_lock_in_service j := by
    apply j_receives_at_least_lock_in_service job_arrival job_cost job_task arr_seq sched tsk
      interference interfering_workload H_work_conserving j H_j_arrives H_job_of_tsk
      H_job_cost_positive t1 t2 H_busy_interval (job_lock_in_service j) h_lis_le_cost
      (A + F - optimism)
    -- Goal: job_lock_in_service j + cumul_interference interference j t1 (t1 + (A + F - optimism)) ≤ A + F - optimism
    -- From FIX2: A + F = tlis + ibf(A, A+F)
    -- cumul_interf(t1, t1+(A+F-opt)) ≤ cumul_interf(t1, t1+(A+F)) ≤ ibf(A, A+F) = A + F - tlis
    -- So lis + cumul_interf ≤ lis + (A+F-tlis) = A+F - (tlis-lis) = A+F - opt
    have h_cumul_mono : cumul_interference interference j t1 (t1 + (A + F - optimism)) ≤
        cumul_interference interference j t1 (t1 + (A + F)) := by
      unfold cumul_interference
      apply Finset.sum_le_sum_of_subset
      apply Finset.Ico_subset_Ico (le_refl _)
      simp only [Time] at *; omega
    have h_ibf_val : interference_bound_function tsk A (A + F) = A + F - task_lock_in_service tsk := by
      simp only [Time] at *; omega
    simp only [Time] at *; omega
  -- Now use job_completes_after_reaching_lock_in_service
  have h_complete := job_completes_after_reaching_lock_in_service job_arrival job_cost
    job_task arr_seq sched tsk interference interfering_workload j H_j_arrives
    (H_completed_jobs_dont_execute := H_completed_jobs_dont_execute)
    (H_job_nonpreemptive_after_lock_in_service := PRJ3)
    (t1 + (A + F - optimism)) h_ESERV
  -- h_complete : completed_by job_cost sched j (t1 + (A+F-opt) + (job_cost j - job_lock_in_service j))
  exact h_complete

end FixpointIsNoLessThanArrival

