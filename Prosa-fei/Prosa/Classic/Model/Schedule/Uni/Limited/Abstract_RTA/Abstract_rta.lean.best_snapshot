    simp only [Time] at *; omega
  have h_equiv := H_equivalent (A_sp + F_sp) h_lt_L
  rw [h_equiv] at h_IB
  -- h_IB : cumul_interference ... ≤ interference_bound_function tsk A_sp (A_sp + F_sp)
  -- Step 4: Apply j_receives_at_least_lock_in_service
  have h_lis_le_cost : job_lock_in_service j ≤ job_cost j :=
    PRJ2 j H_j_arrives H_job_cost_positive
  apply j_receives_at_least_lock_in_service job_arrival job_cost job_task arr_seq sched tsk
    interference interfering_workload H_work_conserving j H_j_arrives H_job_of_tsk
    H_job_cost_positive t1 t2 H_busy_interval (job_lock_in_service j) h_lis_le_cost
    (A_sp + F_sp)
  -- Goal: job_lock_in_service j + cumul_interference interference j t1 (t1 + (A_sp + F_sp)) ≤ A_sp + F_sp
  -- From H_fixpoint: A_sp + F_sp = task_lock_in_service tsk + interference_bound_function tsk A_sp (A_sp + F_sp)
  -- From PRT2: job_lock_in_service j ≤ task_lock_in_service tsk
  have h_lis_le_tlis : job_lock_in_service j ≤ task_lock_in_service tsk :=
    PRT2 j H_j_arrives H_job_of_tsk
  rw [H_fixpoint]
  simp only [Time] at *; omega

include H_proper_job_lock_in_service H_proper_task_lock_in_service
  H_jobs_must_arrive_to_execute
  H_work_conserving H_busy_interval_exists H_job_interference_is_bounded
  H_busy_interval H_equivalent H_fixpoint H_small_fixpoint_solution
  H_fixpoint_is_less_that_relative_arrival_of_j H_j_arrives H_job_of_tsk H_job_cost_positive in
theorem relative_arrival_time_is_no_less_than_fixpoint :
    False := by
  obtain ⟨PRJ1, PRJ2, PRJ3⟩ := H_proper_job_lock_in_service
  obtain ⟨PRT1, PRT2⟩ := H_proper_task_lock_in_service
  obtain ⟨⟨h_t1_le_arr, h_arr_lt_t2, h_qt1, h_not_qt⟩, h_qt2⟩ := H_busy_interval
  have ESERV := service_of_job_ge_lock_in_service task_cost job_arrival job_cost job_task arr_seq
    H_arrival_times_are_consistent sched H_jobs_come_from_arrival_sequence
    tsk interference interfering_workload H_work_conserving L H_busy_interval_exists
    interference_bound_function H_job_interference_is_bounded j H_j_arrives H_job_of_tsk
    H_job_cost_positive t1 t2 H_busy_interval A_sp F_sp H_A_gt_Asp H_equivalent
    H_Asp_is_in_search_space H_fixpoint H_small_fixpoint_solution
    H_fixpoint_is_less_that_relative_arrival_of_j
    H_proper_job_lock_in_service H_proper_task_lock_in_service
  -- service sched j (t1 + (A_sp + F_sp)) ≥ job_lock_in_service j
  -- But j hasn't arrived by t1 + (A_sp + F_sp) since A_sp + F_sp < job_arrival j - t1
  -- So service = 0, but lock_in_service > 0
  have h_not_arrived : t1 + (A_sp + F_sp) ≤ job_arrival j := by
    simp only [Time] at *; omega
  have h_service_zero : service sched j (t1 + (A_sp + F_sp)) = 0 := by
    unfold service service_during
    rw [cumulative_service_before_job_arrival_zero job_arrival sched H_jobs_must_arrive_to_execute j 0 (t1 + (A_sp + F_sp)) h_not_arrived]
  have h_pos : 0 < job_lock_in_service j := PRJ1 j H_j_arrives H_job_cost_positive
  simp only [Time] at *; omega

end FixpointCannotBeSmallerThanArrival

