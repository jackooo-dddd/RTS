include H_proper_job_lock_in_service H_proper_task_lock_in_service
  H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_job_cost_le_task_cost
  H_work_conserving H_busy_interval_exists H_job_interference_is_bounded H_R_is_maximum in
theorem uniprocessor_response_time_bound :
    is_response_time_bound_of_task job_arrival job_cost job_task arr_seq sched tsk R := by
  intro j ARR JOBtsk
  -- Check if job cost is 0
  by_cases POS : job_cost j > 0
  · -- Get busy interval
    obtain ⟨t1, t2, h_le, h_lt, h_bound, h_busy⟩ :=
      H_busy_interval_exists j ARR JOBtsk POS
    -- Get A < L
    have A2LTL := relative_arrival_is_bounded job_arrival job_cost job_task arr_seq sched
      tsk interference interfering_workload L H_busy_interval_exists
      j ARR JOBtsk POS t1 t2 h_busy
    -- Get representative
    obtain ⟨A1, ALEA2, EQΦ, INSP⟩ := representative_exists tsk L interference_bound_function
      (job_arrival j - t1) A2LTL
    -- Get fixpoint solution
    obtain ⟨F1, FIX1, LE1⟩ := H_R_is_maximum A1 INSP
    -- Case split on t1 + (A1 + F1) vs t2
    by_cases BIG : t2 ≤ t1 + (A1 + F1)
    · -- Fixpoint outside busy interval
      apply job_completed_by_arrival_plus_R_1 (H_completed_jobs_dont_execute := H_completed_jobs_dont_execute)
        (H_busy_interval := h_busy) (H_A_gt_Asp := by simp only [Time] at *; omega)
        (H_R_gt_Fsp := LE1) (H_big_fixpoint_solution := BIG)
    · -- Fixpoint inside busy interval
      push_neg at BIG
      by_cases BOUND : job_arrival j - t1 ≤ A1 + F1
      · -- Fixpoint ≥ relative arrival
        apply job_completed_by_arrival_plus_R_2
          (H_proper_job_lock_in_service := H_proper_job_lock_in_service)
          (H_proper_task_lock_in_service := H_proper_task_lock_in_service)
          (H_work_conserving := H_work_conserving) (H_busy_interval_exists := H_busy_interval_exists)
          (H_job_interference_is_bounded := H_job_interference_is_bounded)
          (H_job_cost_le_task_cost := H_job_cost_le_task_cost)
          (H_busy_interval := h_busy) (H_equivalent := EQΦ) (H_fixpoint := FIX1)
          (H_R_gt_Fsp := LE1) (H_small_fixpoint_solution := BIG)
          (H_fixpoint_is_no_less_than_relative_arrival_of_j := BOUND)
          (H_j_arrives := ARR) (H_job_of_tsk := JOBtsk) (H_job_cost_positive := POS)
      · -- Contradiction case
        push_neg at BOUND
        exfalso
        apply relative_arrival_time_is_no_less_than_fixpoint
          (H_proper_job_lock_in_service := H_proper_job_lock_in_service)
          (H_proper_task_lock_in_service := H_proper_task_lock_in_service)
          (H_jobs_must_arrive_to_execute := H_jobs_must_arrive_to_execute)
          (H_work_conserving := H_work_conserving) (H_busy_interval_exists := H_busy_interval_exists)
          (H_job_interference_is_bounded := H_job_interference_is_bounded)
          (H_busy_interval := h_busy) (H_equivalent := EQΦ) (H_fixpoint := FIX1)
          (H_small_fixpoint_solution := BIG)
          (H_fixpoint_is_less_that_relative_arrival_of_j := BOUND)
          (H_j_arrives := ARR) (H_job_of_tsk := JOBtsk) (H_job_cost_positive := POS)
  · -- Job cost is 0
    push_neg at POS
    simp only [is_response_time_bound_of_job, completed_by, service]
    have : job_cost j = 0 := by simp only [Time] at *; omega
    simp [this]

end Abstract_RTA

