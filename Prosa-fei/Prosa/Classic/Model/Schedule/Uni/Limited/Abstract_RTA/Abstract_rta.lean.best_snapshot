theorem service_of_job_ge_lock_in_service :
    service sched j (t1 + (A_sp + F_sp)) ≥ job_lock_in_service j := by
  obtain ⟨PRJ1, PRJ2, PRJ3⟩ := H_proper_job_lock_in_service
  obtain ⟨PRT1, PRT2⟩ := H_proper_task_lock_in_service
  obtain ⟨⟨h_t1_le_arr, h_arr_lt_t2, h_qt1, h_not_qt⟩, h_qt2⟩ := H_busy_interval
  -- Step 1: Show j is not completed at t1 + (A_sp + F_sp)
  have h_not_compl : ¬ completed_by job_cost sched j (t1 + (A_sp + F_sp)) := by
    intro h_compl
    -- If completed at t1 + (A_sp + F_sp), then also at t1 + (job_arrival j - t1) = job_arrival j
    -- since A_sp + F_sp < job_arrival j - t1
    have h_compl_arr : completed_by job_cost sched j (job_arrival j) := by
      apply completion_monotonic job_cost sched j (t1 + (A_sp + F_sp)) (job_arrival j)
      · simp only [Time] at *; omega
      · exact h_compl
    -- But service at arrival is 0 and job_cost > 0
    unfold completed_by at h_compl_arr
    unfold service service_during at h_compl_arr
    rw [cumulative_service_before_job_arrival_zero job_arrival sched H_jobs_must_arrive_to_execute j 0 (job_arrival j) (le_refl _)] at h_compl_arr
    simp only [Time] at *; omega
