namespace RTAforFPwithBoundedNonpreemptiveSegmentsWithArrivalCurves

section Analysis

  variable {Task : Type} [DecidableEq Task]
  variable (task_max_nps task_cost : Task → Time)

  variable {Job : Type} [DecidableEq Job]
  variable (job_arrival : Job → Time)
  variable (job_max_nps : Job → Time)
  variable (job_cost : Job → Time)
  variable (job_task : Job → Task)

  variable (arr_seq : arrival_sequence Job)
  variable (H_arrival_times_are_consistent :
    arrival_times_are_consistent job_arrival arr_seq)
  variable (H_arr_seq_is_a_set :
    arrival_sequence_is_a_set arr_seq)

  variable (sched : schedule Job)
  variable (H_jobs_come_from_arrival_sequence :
    jobs_come_from_arrival_sequence sched arr_seq)

  variable (H_jobs_must_arrive_to_execute :
    jobs_must_arrive_to_execute job_arrival sched)
  variable (H_completed_jobs_dont_execute :
    completed_jobs_dont_execute job_cost sched)

  variable (H_sequential_jobs :
    sequential_jobs job_arrival job_cost sched job_task)

  variable (H_job_cost_le_task_cost :
    cost_of_jobs_from_arrival_sequence_le_task_cost
      task_cost job_cost job_task arr_seq)

  variable (higher_eq_priority : FP_policy Task)
  variable (H_priority_is_reflexive : FP_is_reflexive higher_eq_priority)
  variable (H_priority_is_transitive : FP_is_transitive higher_eq_priority)

  variable (can_be_preempted : Job → Time → Bool)

  variable (H_correct_preemption_model :
    correct_preemption_model arr_seq sched can_be_preempted)
  variable (H_model_with_bounded_nonpreemptive_segments :
    model_with_bounded_nonpreemptive_segments
      job_cost job_task arr_seq can_be_preempted job_max_nps task_max_nps)

  variable (H_work_conserving :
    Prosa.Classic.Model.Schedule.Uni.Limited.Platform.Definitions.LimitedPreemptionPlatform.work_conserving
      job_arrival job_cost arr_seq sched)

  variable (H_respects_policy :
    respects_FP_policy_at_preemption_point
      job_arrival job_cost job_task arr_seq sched can_be_preempted higher_eq_priority)

  variable (ts : List Task)

  variable (H_all_jobs_from_taskset :
    ∀ j, arrives_in arr_seq j → job_task j ∈ ts)

  variable (tsk : Task)
  variable (H_tsk_in_ts : tsk ∈ ts)

  variable (max_arrivals : Task → Time → Nat)
  variable (H_family_of_proper_arrival_curves :
    family_of_proper_arrival_curves job_task arr_seq max_arrivals ts)

  variable (job_lock_in_service : Job → Time)
  variable (task_lock_in_service : Task → Time)

  variable (H_proper_job_lock_in_service :
    proper_job_lock_in_service job_cost arr_seq sched job_lock_in_service)

  variable (H_proper_task_lock_in_service :
    proper_task_lock_in_service
      task_cost job_task arr_seq job_lock_in_service task_lock_in_service tsk)

  private noncomputable def max_length_of_priority_inversion (j : Job) (t : Time) : Nat :=
    ((jobs_arrived_before arr_seq t).filter
      (fun j_lp => !(FP_to_JLFP job_task higher_eq_priority j_lp j))).foldl
      (fun acc j_lp => max acc (job_max_nps j_lp - ε)) 0

  noncomputable def blocking_bound : Nat :=
    ((ts.filter (fun tsk_other => !(higher_eq_priority tsk_other tsk))).map
      (fun tsk_other => task_max_nps tsk_other - ε)).foldl max 0

  section PriorityInversionIsBounded

    include H_arrival_times_are_consistent H_arr_seq_is_a_set H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_job_cost_le_task_cost H_priority_is_reflexive H_priority_is_transitive H_correct_preemption_model H_model_with_bounded_nonpreemptive_segments H_work_conserving H_respects_policy H_all_jobs_from_taskset H_tsk_in_ts H_family_of_proper_arrival_curves H_proper_job_lock_in_service H_proper_task_lock_in_service in
    theorem priority_inversion_is_bounded_by_blocking :
        ∀ j t,
          arrives_in arr_seq j →
          job_task j = tsk →
          max_length_of_priority_inversion job_max_nps job_task arr_seq higher_eq_priority j t ≤
          blocking_bound task_max_nps higher_eq_priority ts tsk := by
      intro j t ARR TSK
      -- Unfold the private definition of max_length_of_priority_inversion
      unfold max_length_of_priority_inversion
      -- We need to show that foldl (fun acc j_lp => max acc (job_max_nps j_lp - ε)) 0 (filter ...) ≤
      -- ((ts.filter ...).map ...).foldl max 0
      -- First, convert the foldl with function to foldl max on mapped list
      have h_foldl_eq : ∀ (l : List Job) (f : Job → Nat),
          l.foldl (fun acc j_lp => max acc (f j_lp)) 0 = (l.map f).foldl max 0 := by
        intro l f
        suffices h : ∀ acc, l.foldl (fun a j_lp => max a (f j_lp)) acc = (l.map f).foldl max acc by
          exact h 0
        induction l with
        | nil => simp [List.foldl]
        | cons x xs ih => intro acc; simp [List.foldl, List.map, ih]
      rw [h_foldl_eq]
      -- Now we need:
      -- ((filter ... jobs).map (fun j_lp => job_max_nps j_lp - ε)).foldl max 0 ≤
      -- ((filter ... ts).map (fun tsk => task_max_nps tsk - ε)).foldl max 0
      -- Suffices to show each element in the LHS list is ≤ some element in the RHS max
      -- i.e., for each element x in the LHS foldl, x ≤ RHS foldl
      -- Use: foldl max 0 l ≤ m iff all elements of l are ≤ m (and 0 ≤ m)
      have h_foldl_le : ∀ (l : List ℕ) (m : ℕ),
          (∀ x, x ∈ l → x ≤ m) → l.foldl max 0 ≤ m := by
        intro l m h_all
        induction l with
        | nil => simp [List.foldl]
        | cons y ys ih =>
          simp only [List.foldl_cons]
          have : ∀ x, x ∈ ys → x ≤ m := fun x hx => h_all x (List.mem_cons_of_mem y hx)
          have h_y_le : y ≤ m := h_all y (List.mem_cons.mpr (Or.inl rfl))
          -- Need: foldl max (max 0 y) ys ≤ m
          -- Since max 0 y ≤ m and all elements of ys ≤ m
          have h_mono : ∀ (acc : ℕ) (l : List ℕ),
              (∀ x, x ∈ l → x ≤ m) → acc ≤ m → l.foldl max acc ≤ m := by
            intro acc l
            induction l generalizing acc with
            | nil => intro _ h; exact h
            | cons z zs ihz =>
              intro h_all' h_acc
              simp only [List.foldl_cons]
              apply ihz
              · intro x hx; exact h_all' x (List.mem_cons_of_mem z hx)
              · exact max_le h_acc (h_all' z (List.mem_cons.mpr (Or.inl rfl)))
          exact h_mono _ ys this (max_le (Nat.zero_le m) h_y_le)
      apply h_foldl_le
      -- Now show each job_max_nps j_lp - ε ≤ blocking_bound for j_lp in the filtered list
      intro x hx
      simp only [List.mem_map] at hx
      obtain ⟨j_lp, hj_lp_mem, rfl⟩ := hx
      simp only [List.mem_filter] at hj_lp_mem
      obtain ⟨hj_lp_arrived, hj_lp_not_hep⟩ := hj_lp_mem
      -- j_lp is in jobs_arrived_before arr_seq t and ¬ FP_to_JLFP ... j_lp j
      -- From hj_lp_not_hep: !(FP_to_JLFP job_task higher_eq_priority j_lp j) = true
      -- This means: ¬ (higher_eq_priority (job_task j_lp) (job_task j))
      -- Since TSK: job_task j = tsk, this means ¬ (higher_eq_priority (job_task j_lp) tsk)
      -- We need: job_max_nps j_lp - ε ≤ blocking_bound
      -- blocking_bound = ((ts.filter ...).map (fun tsk => task_max_nps tsk - ε)).foldl max 0
      -- Suffices: job_max_nps j_lp - ε ≤ task_max_nps (job_task j_lp) - ε and
      --           task_max_nps (job_task j_lp) - ε ∈ the foldl
      -- First, j_lp arrives in arr_seq
      have hj_lp_arrives : arrives_in arr_seq j_lp := by
        unfold jobs_arrived_before jobs_arrived_between at hj_lp_arrived
        exact in_arrivals_implies_arrived job_arrival arr_seq H_arrival_times_are_consistent j_lp 0 t hj_lp_arrived
      -- job_max_nps j_lp ≤ task_max_nps (job_task j_lp) from bounded NPS model
      have hj_lp_bounded := H_model_with_bounded_nonpreemptive_segments j_lp hj_lp_arrives
      obtain ⟨_, _, hj_lp_nps_le, _⟩ := hj_lp_bounded
      -- hj_lp_nps_le : job_max_nonpreemptive_segment_le_task_max_nonpreemptive_segment
      unfold job_max_nonpreemptive_segment_le_task_max_nonpreemptive_segment at hj_lp_nps_le
      have hj_lp_le : job_max_nps j_lp ≤ task_max_nps (job_task j_lp) := hj_lp_nps_le hj_lp_arrives
      -- job_task j_lp ∈ ts
      have hj_lp_task_in_ts : job_task j_lp ∈ ts := H_all_jobs_from_taskset j_lp hj_lp_arrives
      -- ¬ higher_eq_priority (job_task j_lp) tsk
      unfold FP_to_JLFP at hj_lp_not_hep
      simp only [Bool.not_eq_eq_eq_not, Bool.not_true] at hj_lp_not_hep
      rw [TSK] at hj_lp_not_hep
      -- Now show job_max_nps j_lp - ε ≤ blocking_bound
      unfold blocking_bound
      -- blocking_bound = ((ts.filter (fun tsk_other => !(higher_eq_priority tsk_other tsk))).map
      --                    (fun tsk_other => task_max_nps tsk_other - ε)).foldl max 0
      -- task_max_nps (job_task j_lp) - ε is in this list
      apply le_trans (Nat.sub_le_sub_right hj_lp_le ε)
      -- Now need: task_max_nps (job_task j_lp) - ε ≤ foldl max 0 (map ...)
      -- Because job_task j_lp ∈ ts.filter ... and task_max_nps (job_task j_lp) - ε is in the map
      have h_mem_le : ∀ (l : List ℕ) (a : ℕ), a ∈ l → a ≤ l.foldl max 0 := by
        intro l
        induction l with
        | nil => intro a ha; simp at ha
        | cons y ys ih =>
          intro a ha
          simp only [List.foldl_cons]
          rcases List.mem_cons.mp ha with rfl | h
          · have h_le_foldl : ∀ (acc : ℕ) (l : List ℕ), acc ≤ l.foldl max acc := by
              intro acc l
              induction l generalizing acc with
              | nil => exact le_refl acc
              | cons z zs ihz =>
                simp only [List.foldl_cons]
                exact le_trans (le_max_left acc z) (ihz _)
            exact le_trans (le_max_right 0 a) (h_le_foldl _ ys)
          · have h_mono : ∀ (acc1 acc2 : ℕ) (l : List ℕ), acc1 ≤ acc2 → l.foldl max acc1 ≤ l.foldl max acc2 := by
              intro acc1 acc2 l
              induction l generalizing acc1 acc2 with
              | nil => exact id
              | cons z zs ihz =>
                intro hle; simp only [List.foldl_cons]
                apply ihz; exact max_le_max_right z hle
            exact le_trans (ih a h) (h_mono 0 (max 0 y) ys (Nat.zero_le _))
      apply h_mem_le
      apply List.mem_map.mpr
      exact ⟨job_task j_lp, List.mem_filter_of_mem hj_lp_task_in_ts (by simp [hj_lp_not_hep]), rfl⟩

    include H_arrival_times_are_consistent H_arr_seq_is_a_set H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_job_cost_le_task_cost H_priority_is_reflexive H_priority_is_transitive H_correct_preemption_model H_model_with_bounded_nonpreemptive_segments H_work_conserving H_respects_policy H_all_jobs_from_taskset H_tsk_in_ts H_family_of_proper_arrival_curves H_proper_job_lock_in_service H_proper_task_lock_in_service in
    theorem priority_inversion_is_bounded :
        priority_inversion_is_bounded_by
          job_arrival job_cost job_task arr_seq sched
          (FP_to_JLFP job_task higher_eq_priority)
          tsk (blocking_bound task_max_nps higher_eq_priority ts tsk) := by
      sorry

  end PriorityInversionIsBounded

  section ResponseTimeBound

    variable (L : Time)
    variable (H_L_positive : L > 0)
    variable (H_fixed_point :
      L = blocking_bound task_max_nps higher_eq_priority ts tsk +
          total_hep_request_bound_function_FP task_cost higher_eq_priority max_arrivals ts tsk L)

    variable (R : Nat)
    variable (H_R_is_maximum :
      ∀ A,
        (A < L) ∧
        (task_request_bound_function task_cost max_arrivals tsk A ≠
         task_request_bound_function task_cost max_arrivals tsk (A + ε)) →
        ∃ F,
          A + F = blocking_bound task_max_nps higher_eq_priority ts tsk
                  + (task_request_bound_function task_cost max_arrivals tsk (A + ε) -
                     (task_cost tsk - task_lock_in_service tsk))
                  + total_ohep_request_bound_function_FP task_cost higher_eq_priority max_arrivals ts tsk (A + F) ∧
          F + (task_cost tsk - task_lock_in_service tsk) ≤ R)

    include H_arrival_times_are_consistent H_arr_seq_is_a_set H_jobs_come_from_arrival_sequence H_jobs_must_arrive_to_execute H_completed_jobs_dont_execute H_sequential_jobs H_job_cost_le_task_cost H_priority_is_reflexive H_priority_is_transitive H_correct_preemption_model H_model_with_bounded_nonpreemptive_segments H_work_conserving H_respects_policy H_all_jobs_from_taskset H_tsk_in_ts H_family_of_proper_arrival_curves H_proper_job_lock_in_service H_proper_task_lock_in_service H_L_positive H_fixed_point H_R_is_maximum in
    theorem uniprocessor_response_time_bound_fp_with_bounded_nonpreemptive_segments :
        is_response_time_bound_of_task job_arrival job_cost job_task arr_seq sched tsk R := by
      sorry

  end ResponseTimeBound

end Analysis

end RTAforFPwithBoundedNonpreemptiveSegmentsWithArrivalCurves

end Prosa.Classic.Model.Schedule.Uni.Limited.Fixed_priority.Nonpr_reg.Response_time_bound
