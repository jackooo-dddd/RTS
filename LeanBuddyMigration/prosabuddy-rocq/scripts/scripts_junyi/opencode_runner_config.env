# Shared OpenCode runner configuration.
# Override the file path with OPENCODE_RUN_CONFIG=/path/to/config.env.

# Common experiment knobs.
# Fallback if worker account dirs do not carry the deepseek provider auth:
# OPENCODE_MODEL="opencode/deepseek-v4-flash-free"
# OPENCODE_MODEL="deepseek/deepseek-v4-flash"
# OPENCODE_MODEL="deepseek/deepseek-v4-pro" 
# OPENCODE_MODEL="github-copilot/gpt-5.4"
# OPENCODE_MODEL="openrouter/google/gemini-3.1-flash-lite"
# OPENCODE_MODEL="openrouter/qwen/qwen3.6-flash"
# Direct prosabuddy mode uses the model/API configured in /home/junyi/prosabuddy.
# Pass --model on the runner command line only when you want to override it.
# OPENCODE_MODEL="openrouter/openai/gpt-5.4"
OPENCODE_RUN_NOHUP=1
OPENCODE_ENABLE_SKILL=1
OPENCODE_WITH_PAPER=1
OPENCODE_FULL_PROSA=1
OPENCODE_CASESTUDY_DIR="/home/junyi/dataset/Case_Study"
OPENCODE_RESULTS_ROOT="/home/junyi/results_rebuttal"
OPENCODE_NOHUP_LOG_DIR="/home/junyi/results_rebuttal/nohup"
OPENCODE_MAX_TOTAL_TOKENS=80000000
OPENCODE_MAX_RETRIES=8
OPENCODE_MAX_RATELIMIT_RETRIES=8
OPENCODE_PARALLEL=2
OPENCODE_MIN_PROSA_SOURCE_DIR="/home/junyi/prosabuddy/prosaworkspace"
OPENCODE_FULL_PROSA_SOURCE_DIR="/home/junyi/prosabuddy/prosaworkspace"
OPENCODE_DIRECT_PROSABUDDY=1
OPENCODE_CONFIG_DIR="/home/junyi/prosabuddy/.opencode"
OPENCODE_SKILL_SOURCE_DIR="/home/junyi/prosabuddy/.opencode/skill"

# Only used by the `our` casestudy runner.
# Set OPENCODE_OUR_DIRECT_PROSA_PROBE=0 to skip the adaptive direct-Prosa probe.
OPENCODE_OUR_DIRECT_PROSA_PROBE=0
OPENCODE_OUR_DIRECT_PROSA_AGENT="whole-lemma"
OPENCODE_OUR_DIRECT_PROSA_PROBE_STEPS=99999
OPENCODE_OUR_DIRECT_PROSA_PROBE_TIMEOUT_SECONDS=1800
