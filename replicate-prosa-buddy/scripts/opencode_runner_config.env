# Local copy of ProsaBuddy's scripts_junyi/opencode_runner_config.env.
# Same experiment knobs as the original; only /home/junyi paths are replaced
# with this replication folder, and PARALLEL is 1 (single theorem, single worker).
OPENCODE_RUN_NOHUP=0
OPENCODE_ENABLE_SKILL=1
OPENCODE_WITH_PAPER=1
OPENCODE_FULL_PROSA=1
OPENCODE_CASESTUDY_DIR="/Users/shunqiwang/CityuHK/Research/Lean/TranslationProof/replicate-prosa-buddy/datasets_v06/casestudy_v06"
OPENCODE_RESULTS_ROOT="/Users/shunqiwang/CityuHK/Research/Lean/TranslationProof/replicate-prosa-buddy/results"
OPENCODE_NOHUP_LOG_DIR="/Users/shunqiwang/CityuHK/Research/Lean/TranslationProof/replicate-prosa-buddy/results/nohup"
OPENCODE_MAX_TOTAL_TOKENS=80000000
OPENCODE_MAX_RETRIES=8
OPENCODE_MAX_RATELIMIT_RETRIES=8
OPENCODE_PARALLEL=1
OPENCODE_MIN_PROSA_SOURCE_DIR="/Users/shunqiwang/CityuHK/Research/Lean/TranslationProof/replicate-prosa-buddy/prosa_v06"
OPENCODE_FULL_PROSA_SOURCE_DIR="/Users/shunqiwang/CityuHK/Research/Lean/TranslationProof/replicate-prosa-buddy/prosa_v06"
OPENCODE_DIRECT_PROSABUDDY=1
OPENCODE_CONFIG_DIR="/Users/shunqiwang/CityuHK/Research/Lean/TranslationProof/replicate-prosa-buddy/prosabuddy/.opencode"
OPENCODE_SKILL_SOURCE_DIR="/Users/shunqiwang/CityuHK/Research/Lean/TranslationProof/replicate-prosa-buddy/prosabuddy/.opencode/skill"
OPENCODE_OUR_DIRECT_PROSA_PROBE=0
OPENCODE_OUR_DIRECT_PROSA_AGENT="whole-lemma"
OPENCODE_OUR_DIRECT_PROSA_PROBE_STEPS=99999
OPENCODE_OUR_DIRECT_PROSA_PROBE_TIMEOUT_SECONDS=1800
