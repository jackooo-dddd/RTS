Prosa.Util.Subadditivity.subadditive_standard : (ℕ → ℕ) → Prop
def Prosa.Util.Subadditivity.subadditive_standard : (ℕ → ℕ) → Prop :=
fun f => ∀ (a b : ℕ), f (a + b) ≤ f a + f b
FREEZE_END Prosa.Util.Subadditivity.subadditive_standard
