FREEZE_BEGIN Prosa.Util.Subadditivity.subadditive_at
Prosa.Util.Subadditivity.subadditive_at : (ℕ → ℕ) → ℕ → Prop
def Prosa.Util.Subadditivity.subadditive_at : (ℕ → ℕ) → ℕ → Prop :=
fun f h => ∀ (a b : ℕ), a + b = h → f h ≤ f a + f b
FREEZE_END Prosa.Util.Subadditivity.subadditive_at
FREEZE_BEGIN Prosa.Util.Subadditivity.subadditive_until
Prosa.Util.Subadditivity.subadditive_until : (ℕ → ℕ) → ℕ → Prop
def Prosa.Util.Subadditivity.subadditive_until : (ℕ → ℕ) → ℕ → Prop :=
fun f h => ∀ x < h, Prosa.Util.Subadditivity.subadditive_at f x
FREEZE_END Prosa.Util.Subadditivity.subadditive_until
