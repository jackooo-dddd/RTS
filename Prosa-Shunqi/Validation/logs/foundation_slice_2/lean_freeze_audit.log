  x ∈ s → Prosa.Util.Supremum.supremum R s ≠ none
FREEZE_END Prosa.Util.Supremum.supremum_exists
FREEZE_BEGIN Prosa.Util.Supremum.supremum_none
@Prosa.Util.Supremum.supremum_none : ∀ {T : Type u_1} [DecidableEq T] (R : T → T → Bool) (s : List T),
  Prosa.Util.Supremum.supremum R s = none → s = []
FREEZE_END Prosa.Util.Supremum.supremum_none
FREEZE_BEGIN Prosa.Util.Supremum.supremum_in
@Prosa.Util.Supremum.supremum_in : ∀ {T : Type u_1} [DecidableEq T] (R : T → T → Bool) (x : T) (s : List T),
  Prosa.Util.Supremum.supremum R s = some x → x ∈ s
FREEZE_END Prosa.Util.Supremum.supremum_in
