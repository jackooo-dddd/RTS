Prosa.Util.Subadditivity.subadditive : (ℕ → ℕ) → Prop
def Prosa.Util.Subadditivity.subadditive : (ℕ → ℕ) → Prop :=
fun f => ∀ (h : ℕ), Prosa.Util.Subadditivity.subadditive_at f h
FREEZE_END Prosa.Util.Subadditivity.subadditive
