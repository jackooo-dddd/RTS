                      (_ : is_true
                             (@in_mem (Equality.sort T) x0
                                (@mem (Equality.sort T) 
                                   (seq_predType T) 
                                   (@nil (Equality.sort T)))))
                      (y0 : Equality.sort T)
                      (_ : is_true
                             (@in_mem (Equality.sort T) y0
                                (@mem (Equality.sort T) 
                                   (seq_predType T) 
                                   (@nil (Equality.sort T))))),
                    is_true (R x0 y0))
               (_ : is_true
                      (@in_mem (Equality.sort T) z
                         (@mem (Equality.sort T) (seq_predType T)
                            (@cons (Equality.sort T) s1
                               (@nil (Equality.sort T)))))) =>
             (fun
                ‗evar_0‗ : forall _ : is_true (@eq_op T y s1),
                           is_true (R z y) =>
              @eq_ind_r bool (@eq_op T y s1)
                (fun ‗pattern_value‗ : bool =>
                 forall _ : is_true ‗pattern_value‗, is_true (R z y))
                ‗evar_0‗
                (@in_mem (Equality.sort T) y
                   (@mem (Equality.sort T) (seq_predType T)
                      (@cons (Equality.sort T) s1 (@nil (Equality.sort T)))))
                (@mem_seq1 T y s1))
               (fun ‗view_subject‗ : is_true (@eq_op T y s1) =>
                (fun ‗‗top_assumption‗ : @eq (Equality.sort T) y s1 =>
                 (fun ‗evar_0‗ : is_true (R z s1) =>
                  @eq_ind_r (Equality.sort T) s1
                    (fun ‗pattern_value‗ : Equality.sort T =>
                     is_true (R z ‗pattern_value‗))
                    ‗evar_0‗ y ‗‗top_assumption‗)
                   (let H : @eq (Equality.sort T) s1 z :=
                      @f_equal (option (Equality.sort T)) 
                        (Equality.sort T)
                        (fun e : option (Equality.sort T) =>
                         match e return Equality.sort T with
                         | @Some _ s0 => s0
                         | @None _ => s1
                         end)
                        (@Some (Equality.sort T) s1)
                        (@Some (Equality.sort T) z) SOME_z1
                      in
                    (fun ‗‗top_assumption‗0 : @eq (Equality.sort T) s1 z =>
                     (fun ‗evar_0‗ : is_true (R z z) =>
                      @eq_ind_r (Equality.sort T) z
                        (fun ‗pattern_value‗ : Equality.sort T =>
                         is_true (R z ‗pattern_value‗))
                        ‗evar_0‗ s1 ‗‗top_assumption‗0)
                       (H_R_reflexive z))
                      H))
                  (@elimTF (@eq (Equality.sort T) y s1) 
                     (@eq_op T y s1) true (@eqP T y s1) ‗view_subject‗)))
            sn SUPR1 IH0 IN_z_s
      end SUPR IH SOME_z0)
     SOME_z)
  x SOME_x (@supremum_in T R x s SOME_x)
     : forall {T : Equality.type} (R : rel (Equality.sort T))
         (_ : @reflexive (Equality.sort T) R)
         (_ : @total (Equality.sort T) R)
         (_ : @transitive (Equality.sort T) R) (x : Equality.sort T)
         (s : list (Equality.sort T))
         (_ : @eq (option (Equality.sort T)) (@supremum T R s)
                (@Some (Equality.sort T) x))
         (y : Equality.sort T)
         (_ : is_true
                (@in_mem (Equality.sort T) y
                   (@mem (Equality.sort T) (seq_predType T) s))),
       is_true (R x y)

Arguments supremum_spec {T} R H_R_reflexive H_R_total 
  H_R_transitive x s%_seq_scope _ y _
reflexive
     : forall (T : Type) (_ : rel T), Prop
reflexive =
fun (T : Type) (R : rel T) => forall x : T, is_true (R x x)
     : forall [T : Type] (_ : rel T), Prop

Arguments reflexive [T]%_type_scope R
total
     : forall (T : Type) (_ : rel T), Prop
total =
fun (T : Type) (R : rel T) => forall x y : T, is_true (orb (R x y) (R y x))
     : forall [T : Type] (_ : rel T), Prop

Arguments total [T]%_type_scope R
transitive
     : forall (T : Type) (_ : rel T), Prop
transitive =
fun (T : Type) (R : rel T) =>
forall (y x z : T) (_ : is_true (R x y)) (_ : is_true (R y z)),
is_true (R x z)
     : forall [T : Type] (_ : rel T), Prop

Arguments transitive [T]%_type_scope R
