--- a/src/Lean.v
+++ b/src/Lean.v
@@ -361,6 +361,41 @@ Section strings.
     rewrite <- Nat_pow_comm. eapply Nat_lt_to_N.
   Qed.
 
+  Lemma LeanImport_Nat_le_trans (n m p : Nat) : n <= m -> m <= p -> n <= p.
+  Proof.
+    intros Hnm Hmp. induction Hmp.
+    - exact Hnm.
+    - constructor. exact IHHmp.
+  Qed.
+
+  Lemma LeanImport_Nat_lt_trans (n m p : Nat) : n < m -> m < p -> n < p.
+  Proof.
+    intros Hnm Hmp.
+    eapply LeanImport_Nat_le_trans; [ exact Hnm | ].
+    eapply LeanImport_Nat_le_trans; [ constructor; exact (Nat_le_refl m) | exact Hmp ].
+  Qed.
+
+  Lemma Nat_isValidChar_lt_pow32 (n : Nat) :
+    Nat_isValidChar n -> n < Nat_pow 2 32.
+  Proof.
+    intro Hvalid.
+    eapply LeanImport_Nat_lt_trans.
+    - destruct Hvalid as [Hsmall | Hlarge].
+      + eapply LeanImport_Nat_lt_trans; [ exact Hsmall | ].
+        exact (Nat_lt_to_N 0xd800 0x110000 Logic.eq_refl).
+      + destruct Hlarge as [Hlower Hupper]. exact Hupper.
+    - exact (Nat_lt_to_N_pow 0x110000 32 Logic.eq_refl).
+  Qed.
+
+  Definition Char_ofNatAux (n : Nat) (h : Nat_isValidChar n) : Char :=
+    Char_mk
+      (UInt32_ofBitVec
+         (BitVec_ofFin 32
+            (Fin_mk (Nat_pow 2 32) n (Nat_isValidChar_lt_pow32 n h))))
+      h.
+
+  Register Char_ofNatAux as lean.Char_ofNatAux.
+
   Definition Fin_mk_N_pow (n : N) (val : N) (isLt : (val <? 2 ^ n)%N = true) : Fin (Nat_pow 2 (Nat_of_N n))
     := Fin_mk (Nat_pow 2 (Nat_of_N n)) (Nat_of_N val) (Nat_lt_to_N_pow val n isLt).
 
