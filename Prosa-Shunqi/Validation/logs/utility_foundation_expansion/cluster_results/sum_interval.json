      "lean_elaborated_type": "Prosa.Util.Sum.sum_le_summation_range : \u2200 (f : \u2115 \u2192 \u2115) (t \u0394 : \u2115),\n  \u2211 x \u2208 Finset.Ico t (t + \u0394), f x < \u0394 \u2192 \u2203 x, t \u2264 x \u2227 x < t + \u0394 \u2227 f x = 0\ntheorem Prosa.Util.Sum.sum_le_summation_range : \u2200 (f : \u2115 \u2192 \u2115) (t \u0394 : \u2115),\n  \u2211 x \u2208 Finset.Ico t (t + \u0394), f x < \u0394 \u2192 \u2203 x, t \u2264 x \u2227 x < t + \u0394 \u2227 f x = 0 :=\nfun f t \u0394 h =>\n  Classical.byContradiction fun hall =>\n    have hle :=\n      Trans.trans (Eq.symm (Prosa.Util.Sum.sum_of_ones t \u0394))\n        (Finset.sum_le_sum fun i hi =>\n          have hirange := Finset.mem_Ico.mp hi;\n          have hne :=\n            Eq.mp\n              (Eq.trans (Mathlib.Tactic.Push.not_exists._simp_1 fun x => t \u2264 x \u2227 x < t + \u0394 \u2227 f x = 0)\n                (forall_congr fun x =>\n                  Eq.trans (Mathlib.Tactic.Push.not_and_eq (t \u2264 x) (x < t + \u0394 \u2227 f x = 0))\n                    (implies_congr (Eq.refl (t \u2264 x)) (Mathlib.Tactic.Push.not_and_eq (x < t + \u0394) (f x = 0)))))\n              hall i hirange.left hirange.right;\n          Decidable.byContradiction fun a => Prosa.Util.Sum.sum_le_summation_range._proof_1_1 f t \u0394 i hne a);\n    Prosa.Util.Sum.sum_le_summation_range._proof_1_2 f t \u0394 h hle",
