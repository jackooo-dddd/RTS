FREEZE_BEGIN Prosa.Util.UnitGrowth.unit_growth_function
Prosa.Util.UnitGrowth.unit_growth_function : (ℕ → ℕ) → Prop
def Prosa.Util.UnitGrowth.unit_growth_function : (ℕ → ℕ) → Prop :=
fun f => ∀ (t : ℕ), f (t + 1) ≤ f t + 1
