Prosa.Validation.FiniteSumNormalization.big_nat_eq0_guard :
  (∀ (m n : ℕ) (F : ℕ → ℕ), ∑ i ∈ Finset.Ico m n, F i = 0 ↔ ∀ (i : ℕ), m ≤ i ∧ i < n → F i = 0) =
    ∀ (m n : ℕ) (F : ℕ → ℕ),
      List.foldr Nat.add Nat.zero (List.map (fun i => F i) (List.range' m (n.sub m) 1)) = 0 ↔
        ∀ (i : ℕ), m ≤ i ∧ i < n → F i = 0
Prosa.Validation.FiniteSumNormalization.sum_of_ones_guard :
  (∀ (t Δ : ℕ), ∑ x ∈ Finset.Ico t (t + Δ), 1 = Δ) =
    ∀ (t Δ : ℕ), List.foldr Nat.add Nat.zero (List.map (fun x => 1) (List.range' t ((t.add Δ).sub t) 1)) = Δ
Prosa.Validation.FiniteSumNormalization.sum_le_summation_range_guard :
  (∀ (f : ℕ → ℕ) (t Δ : ℕ), ∑ x ∈ Finset.Ico t (t + Δ), f x < Δ → ∃ x, t ≤ x ∧ x < t + Δ ∧ f x = 0) =
    ∀ (f : ℕ → ℕ) (t Δ : ℕ),
      List.foldr Nat.add Nat.zero (List.map (fun x => f x) (List.range' t ((t + Δ).sub t) Nat.zero.succ)) < Δ →
        ∃ x, t.le x ∧ x.succ.le (t.add Δ) ∧ f x = 0
