FREEZE_BEGIN Prosa.Util.Sum.sum_of_ones
Prosa.Util.Sum.sum_of_ones : ∀ (t Δ : ℕ), ∑ x ∈ Finset.Ico t (t + Δ), 1 = Δ
theorem Prosa.Util.Sum.sum_of_ones : ∀ (t Δ : ℕ), ∑ x ∈ Finset.Ico t (t + Δ), 1 = Δ :=
fun t Δ =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans (Finset.sum_const 1)
            (Eq.trans
              (congrFun' (congrArg HSMul.hSMul (Eq.trans (Nat.card_Ico t (t + Δ)) (add_tsub_cancel_left t Δ))) 1)
              (mul_one Δ))))
        Δ)
      (eq_self Δ))
FREEZE_END Prosa.Util.Sum.sum_of_ones
FREEZE_BEGIN Prosa.Util.Sum.big_nat_eq0
Prosa.Util.Sum.big_nat_eq0 : ∀ (m n : ℕ) (F : ℕ → ℕ), ∑ i ∈ Finset.Ico m n, F i = 0 ↔ ∀ (i : ℕ), m ≤ i ∧ i < n → F i = 0
theorem Prosa.Util.Sum.big_nat_eq0 : ∀ (m n : ℕ) (F : ℕ → ℕ),
  ∑ i ∈ Finset.Ico m n, F i = 0 ↔ ∀ (i : ℕ), m ≤ i ∧ i < n → F i = 0 :=
fun m n F =>
  { mp := fun hsum i hi => Finset.sum_eq_zero_iff.mp hsum i (Finset.mem_Ico.mpr hi),
    mpr := fun hall => Finset.sum_eq_zero fun i hi => hall i (Finset.mem_Ico.mp hi) }
FREEZE_END Prosa.Util.Sum.big_nat_eq0
FREEZE_BEGIN Prosa.Util.Sum.sum_le_summation_range
Prosa.Util.Sum.sum_le_summation_range : ∀ (f : ℕ → ℕ) (t Δ : ℕ),
  ∑ x ∈ Finset.Ico t (t + Δ), f x < Δ → ∃ x, t ≤ x ∧ x < t + Δ ∧ f x = 0
theorem Prosa.Util.Sum.sum_le_summation_range : ∀ (f : ℕ → ℕ) (t Δ : ℕ),
  ∑ x ∈ Finset.Ico t (t + Δ), f x < Δ → ∃ x, t ≤ x ∧ x < t + Δ ∧ f x = 0 :=
fun f t Δ h =>
  Classical.byContradiction fun hall =>
    have hle :=
      Trans.trans (Eq.symm (Prosa.Util.Sum.sum_of_ones t Δ))
        (Finset.sum_le_sum fun i hi =>
          have hirange := Finset.mem_Ico.mp hi;
          have hne :=
            Eq.mp
              (Eq.trans (Mathlib.Tactic.Push.not_exists._simp_1 fun x => t ≤ x ∧ x < t + Δ ∧ f x = 0)
                (forall_congr fun x =>
                  Eq.trans (Mathlib.Tactic.Push.not_and_eq (t ≤ x) (x < t + Δ ∧ f x = 0))
                    (implies_congr (Eq.refl (t ≤ x)) (Mathlib.Tactic.Push.not_and_eq (x < t + Δ) (f x = 0)))))
              hall i hirange.left hirange.right;
          Decidable.byContradiction fun a => Prosa.Util.Sum.sum_le_summation_range._proof_1_1 f t Δ i hne a);
    Prosa.Util.Sum.sum_le_summation_range._proof_1_2 f t Δ h hle
FREEZE_END Prosa.Util.Sum.sum_le_summation_range
FREEZE_BEGIN Prosa.Util.Sum.big_sum_eq_in_eq_sized_intervals
Prosa.Util.Sum.big_sum_eq_in_eq_sized_intervals : ∀ (t1 t2 d : ℕ) (F1 F2 : ℕ → ℕ),
  (∀ g < d, F1 (t1 + g) = F2 (t2 + g)) → ∑ t ∈ Finset.Ico t1 (t1 + d), F1 t = ∑ t ∈ Finset.Ico t2 (t2 + d), F2 t
theorem Prosa.Util.Sum.big_sum_eq_in_eq_sized_intervals : ∀ (t1 t2 d : ℕ) (F1 F2 : ℕ → ℕ),
  (∀ g < d, F1 (t1 + g) = F2 (t2 + g)) → ∑ t ∈ Finset.Ico t1 (t1 + d), F1 t = ∑ t ∈ Finset.Ico t2 (t2 + d), F2 t :=
fun t1 t2 d F1 F2 heq =>
  Nat.recAux (motive := fun d =>
    (∀ g < d, F1 (t1 + g) = F2 (t2 + g)) → ∑ t ∈ Finset.Ico t1 (t1 + d), F1 t = ∑ t ∈ Finset.Ico t2 (t2 + d), F2 t)
    (fun heq =>
      of_eq_true
        (Eq.trans
          (congr
            (congrArg Eq
              (Finset.sum_congr
                (Eq.trans (congrArg (Finset.Ico t1) (add_zero t1))
                  (Finset.Ico_eq_empty_of_le (of_eq_true (Std.le_refl._simp_1 t1))))
                fun x a => Eq.refl (F1 x)))
            (Finset.sum_congr
              (Eq.trans (congrArg (Finset.Ico t2) (add_zero t2))
                (Finset.Ico_eq_empty_of_le (of_eq_true (Std.le_refl._simp_1 t2))))
              fun x a => Eq.refl (F2 x)))
          (eq_self 0)))
    (fun d ih heq =>
      Eq.mpr
        (id
          (congrArg (fun _a => ∑ t ∈ Finset.Ico t1 _a, F1 t = ∑ t ∈ Finset.Ico t2 (t2 + (d + 1)), F2 t)
            (Nat.add_succ t1 d)))
        (Eq.mpr
          (id
            (congrArg (fun _a => ∑ t ∈ Finset.Ico t1 (t1 + d).succ, F1 t = ∑ t ∈ Finset.Ico t2 _a, F2 t)
              (Nat.add_succ t2 d)))
          (Eq.mpr
            (id
              (congrArg (fun _a => _a = ∑ t ∈ Finset.Ico t2 (t2 + d).succ, F2 t)
                (Finset.sum_Ico_succ_top (Nat.le_add_right t1 d) F1)))
            (Eq.mpr
              (id
                (congrArg (fun _a => ∑ k ∈ Finset.Ico t1 (t1 + d), F1 k + F1 (t1 + d) = _a)
                  (Finset.sum_Ico_succ_top (Nat.le_add_right t2 d) F2)))
              (Eq.mpr
                (id
                  (congrArg (fun _a => _a + F1 (t1 + d) = ∑ k ∈ Finset.Ico t2 (t2 + d), F2 k + F2 (t2 + d))
                    (ih fun g hg => heq g (Nat.lt.step hg))))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        ∑ t ∈ Finset.Ico t2 (t2 + d), F2 t + _a = ∑ k ∈ Finset.Ico t2 (t2 + d), F2 k + F2 (t2 + d))
                      (heq d (Nat.lt_succ_self d))))
                  (Eq.refl (∑ t ∈ Finset.Ico t2 (t2 + d), F2 t + F2 (t2 + d)))))))))
    d heq
FREEZE_END Prosa.Util.Sum.big_sum_eq_in_eq_sized_intervals
FREEZE_BEGIN Prosa.Util.Sum.pigeonhole_on_interval
Prosa.Util.Sum.pigeonhole_on_interval : ∀ (P1 P2 : ℕ → Bool) (t1 t2 n1 n2 : ℕ),
  n1 ≤ ∑ t ∈ Finset.Ico t1 t2, (P1 t).toNat →
    n2 ≤ ∑ t ∈ Finset.Ico t1 t2, (P2 t).toNat → n1 + n2 - (t2 - t1) ≤ ∑ t ∈ Finset.Ico t1 t2, (P1 t && P2 t).toNat
theorem Prosa.Util.Sum.pigeonhole_on_interval : ∀ (P1 P2 : ℕ → Bool) (t1 t2 n1 n2 : ℕ),
  n1 ≤ ∑ t ∈ Finset.Ico t1 t2, (P1 t).toNat →
    n2 ≤ ∑ t ∈ Finset.Ico t1 t2, (P2 t).toNat → n1 + n2 - (t2 - t1) ≤ ∑ t ∈ Finset.Ico t1 t2, (P1 t && P2 t).toNat :=
fun P1 P2 t1 t2 n1 n2 h1 h2 =>
  have hpoint := fun t a =>
    Bool.casesOn (motive := fun t_1 => P1 t = t_1 → (P1 t).toNat + (P2 t).toNat ≤ 1 + (P1 t && P2 t).toNat) (P1 t)
      (fun h =>
        Eq.ndrec (motive := fun x => P1 t = x → x.toNat + (P2 t).toNat ≤ 1 + (x && P2 t).toNat)
          (fun hP1 =>
            Bool.casesOn (motive := fun t_1 => P2 t = t_1 → false.toNat + (P2 t).toNat ≤ 1 + (false && P2 t).toNat)
              (P2 t)
              (fun h =>
                Eq.ndrec (motive := fun x => P2 t = x → false.toNat + x.toNat ≤ 1 + (false && x).toNat)
                  (fun hP2 =>
                    of_eq_true
                      (Eq.trans
                        (congr (congrArg LE.le (add_zero 0))
                          (Eq.trans (congrArg (HAdd.hAdd 1) (congrArg Bool.toNat (Bool.and_self false))) (add_zero 1)))
                        zero_le._simp_1))
                  (Eq.symm h) (Eq.refl (P2 t)))
              (fun h =>
                Eq.ndrec (motive := fun x => P2 t = x → false.toNat + x.toNat ≤ 1 + (false && x).toNat)
                  (fun hP2 =>
                    of_eq_true
                      (Eq.trans
                        (congr (congrArg LE.le (zero_add 1))
                          (Eq.trans (congrArg (HAdd.hAdd 1) (congrArg Bool.toNat (Bool.and_true false))) (add_zero 1)))
                        (Std.le_refl._simp_1 1)))
                  (Eq.symm h) (Eq.refl (P2 t)))
              (Eq.refl (P2 t)))
          (Eq.symm h) (Eq.refl (P1 t)))
      (fun h =>
        Eq.ndrec (motive := fun x => P1 t = x → x.toNat + (P2 t).toNat ≤ 1 + (x && P2 t).toNat)
          (fun hP1 =>
            Bool.casesOn (motive := fun t_1 => P2 t = t_1 → true.toNat + (P2 t).toNat ≤ 1 + (true && P2 t).toNat) (P2 t)
              (fun h =>
                Eq.ndrec (motive := fun x => P2 t = x → true.toNat + x.toNat ≤ 1 + (true && x).toNat)
                  (fun hP2 =>
                    of_eq_true
                      (Eq.trans
                        (congr (congrArg LE.le (add_zero 1))
                          (Eq.trans (congrArg (HAdd.hAdd 1) (congrArg Bool.toNat (Bool.and_false true))) (add_zero 1)))
                        (Std.le_refl._simp_1 1)))
                  (Eq.symm h) (Eq.refl (P2 t)))
              (fun h =>
                Eq.ndrec (motive := fun x => P2 t = x → true.toNat + x.toNat ≤ 1 + (true && x).toNat)
                  (fun hP2 =>
                    of_eq_true
                      (Eq.trans (congrArg (LE.le 2) (congrArg (HAdd.hAdd 1) (congrArg Bool.toNat (Bool.and_self true))))
                        (Std.le_refl._simp_1 2)))
                  (Eq.symm h) (Eq.refl (P2 t)))
              (Eq.refl (P2 t)))
          (Eq.symm h) (Eq.refl (P1 t)))
      (Eq.refl (P1 t));
  have hsum := Finset.sum_le_sum hpoint;
  have htotal :=
    LE.le.trans (Nat.add_le_add h1 h2)
      (Eq.mp
        (congrArg (LE.le (∑ x ∈ Finset.Ico t1 t2, (P1 x).toNat + ∑ x ∈ Finset.Ico t1 t2, (P2 x).toNat))
          (congrFun'
            (congrArg HAdd.hAdd
              (Eq.trans (Finset.sum_const 1)
                (Eq.trans
                  (Eq.trans (congrFun' (congrArg HSMul.hSMul (Nat.card_Ico t1 t2)) 1) (nsmul_eq_mul (t2 - t1) 1))
                  (mul_one ↑(t2 - t1)))))
            (∑ x ∈ Finset.Ico t1 t2, (P1 x && P2 x).toNat)))
        (Eq.mp
          (congrArg (fun _a => ∑ x ∈ Finset.Ico t1 t2, (P1 x).toNat + ∑ x ∈ Finset.Ico t1 t2, (P2 x).toNat ≤ _a)
            Finset.sum_add_distrib)
          (Eq.mp (congrArg (fun _a => _a ≤ ∑ i ∈ Finset.Ico t1 t2, (1 + (P1 i && P2 i).toNat)) Finset.sum_add_distrib)
            hsum)));
  tsub_le_iff_left.mpr htotal
FREEZE_END Prosa.Util.Sum.pigeonhole_on_interval
FREEZE_BEGIN Prosa.Util.Sum.sum_ge_2_nat
Prosa.Util.Sum.sum_ge_2_nat : ∀ (t1 t2 : ℕ) (p : ℕ → ℕ),
  (∀ (t : ℕ), p t ≤ 1) →
    2 ≤ ∑ t ∈ Finset.Ico t1 t2, p t →
      ∃ to1 to2, t1 ≤ to1 ∧ to1 < to2 ∧ to2 < t2 ∧ decide (p to1 = 1) = true ∧ decide (p to2 = 1) = true
theorem Prosa.Util.Sum.sum_ge_2_nat : ∀ (t1 t2 : ℕ) (p : ℕ → ℕ),
  (∀ (t : ℕ), p t ≤ 1) →
    2 ≤ ∑ t ∈ Finset.Ico t1 t2, p t →
      ∃ to1 to2, t1 ≤ to1 ∧ to1 < to2 ∧ to2 < t2 ∧ decide (p to1 = 1) = true ∧ decide (p to2 = 1) = true :=
fun t1 t2 p hle htwo =>
  let xs := (Finset.Ico t1 t2).toList;
  have hsum :=
    of_eq_true
      (Eq.trans (congrFun' (congrArg Eq (Finset.sum_map_toList (Finset.Ico t1 t2) p)) (∑ t ∈ Finset.Ico t1 t2, p t))
        (eq_self ((Finset.Ico t1 t2).sum p)));
  have htwoList := Eq.mpr (id (congrArg (LE.le 2) hsum)) htwo;
  Exists.casesOn
    (Prosa.Util.Sum.sum_ge_2_seq xs p (Finset.nodup_toList (Finset.Ico t1 t2)) (fun x x_1 => hle x) htwoList)
    fun x1 h =>
    Exists.casesOn h fun x2 h =>
      And.casesOn h fun hne right =>
        And.casesOn right fun hx1 right =>
          And.casesOn right fun hx2 right =>
            And.casesOn right fun hp1 hp2 =>
              have hr1 :=
                Finset.mem_Ico.mp
                  (Eq.mpr (id Finset.mem_Ico._simp_1)
                    (Eq.mp (Eq.trans Finset.mem_toList._simp_1 Finset.mem_Ico._simp_1) hx1));
              have hr2 :=
                Finset.mem_Ico.mp
                  (Eq.mpr (id Finset.mem_Ico._simp_1)
                    (Eq.mp (Eq.trans Finset.mem_toList._simp_1 Finset.mem_Ico._simp_1) hx2));
              have hne' := of_decide_eq_true hne;
              Or.casesOn (lt_or_gt_of_ne hne')
                (fun hlt => Exists.intro x1 (Exists.intro x2 ⟨hr1.left, ⟨hlt, ⟨hr2.right, ⟨hp1, hp2⟩⟩⟩⟩)) fun hgt =>
                Exists.intro x2 (Exists.intro x1 ⟨hr2.left, ⟨hgt, ⟨hr1.right, ⟨hp2, hp1⟩⟩⟩⟩)
FREEZE_END Prosa.Util.Sum.sum_ge_2_nat
