                        (Decidable.byContradiction fun a_1 =>
                          Prosa.Util.Sum.eq_sum_leq_seq._proof_1_2 P E1 E2 a r ha hs a_1))))))
            (Eq.symm h) (Eq.refl (P a)))
        (Eq.refl (P a)))
    r hle
FREEZE_END Prosa.Util.Sum.eq_sum_leq_seq
