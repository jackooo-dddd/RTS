Prosa.Validation.FiniteSumNormalization.big_nat_eq0_guard :
  (∀ (m n : ℕ) (F : ℕ → ℕ), ∑ i ∈ Finset.Ico m n, F i = 0 ↔ ∀ (i : ℕ), m ≤ i ∧ i < n → F i = 0) =
    ∀ (m n : ℕ) (F : ℕ → ℕ),
      List.foldr Nat.add Nat.zero (List.map (fun i => F i) (List.range' m (n.sub m) Nat.zero.succ)) = 0 ↔
        ∀ (i : ℕ), m ≤ i ∧ i < n → F i = 0
Prosa.Validation.FiniteSumNormalization.sum_of_ones_guard :
  (∀ (t Δ : ℕ), ∑ x ∈ Finset.Ico t (t + Δ), 1 = Δ) =
    ∀ (t Δ : ℕ), List.foldr Nat.add Nat.zero (List.map (fun x => 1) (List.range' t ((t + Δ).sub t) Nat.zero.succ)) = Δ
Prosa.Validation.FiniteSumNormalization.sum_le_summation_range_guard :
  (∀ (f : ℕ → ℕ) (t Δ : ℕ), ∑ x ∈ Finset.Ico t (t + Δ), f x < Δ → ∃ x, t ≤ x ∧ x < t + Δ ∧ f x = 0) =
    ∀ (f : ℕ → ℕ) (t Δ : ℕ),
      List.foldr Nat.add Nat.zero (List.map (fun x => f x) (List.range' t ((t + Δ).sub t) Nat.zero.succ)) < Δ →
        ∃ x, t ≤ x ∧ x < t + Δ ∧ f x = 0
Prosa.Validation.FiniteSumNormalization.big_sum_eq_in_eq_sized_intervals_guard :
  (∀ (t1 t2 d : ℕ) (F1 F2 : ℕ → ℕ),
      (∀ g < d, F1 (t1 + g) = F2 (t2 + g)) → ∑ t ∈ Finset.Ico t1 (t1 + d), F1 t = ∑ t ∈ Finset.Ico t2 (t2 + d), F2 t) =
    ∀ (t1 t2 d : ℕ) (F1 F2 : ℕ → ℕ),
      (∀ g < d, F1 (t1 + g) = F2 (t2 + g)) →
        List.foldr Nat.add Nat.zero (List.map (fun t => F1 t) (List.range' t1 ((t1 + d).sub t1) Nat.zero.succ)) =
          List.foldr Nat.add Nat.zero (List.map (fun t => F2 t) (List.range' t2 ((t2 + d).sub t2) Nat.zero.succ))
Prosa.Validation.FiniteSumNormalization.pigeonhole_on_interval_guard :
  (∀ (P1 P2 : ℕ → Bool) (t1 t2 n1 n2 : ℕ),
      n1 ≤ ∑ t ∈ Finset.Ico t1 t2, (P1 t).toNat →
        n2 ≤ ∑ t ∈ Finset.Ico t1 t2, (P2 t).toNat →
          n1 + n2 - (t2 - t1) ≤ ∑ t ∈ Finset.Ico t1 t2, (P1 t && P2 t).toNat) =
    ∀ (P1 P2 : ℕ → Bool) (t1 t2 n1 n2 : ℕ),
      n1 ≤ List.foldr Nat.add Nat.zero (List.map (fun t => (P1 t).toNat) (List.range' t1 (t2.sub t1) Nat.zero.succ)) →
        n2 ≤ List.foldr Nat.add Nat.zero (List.map (fun t => (P2 t).toNat) (List.range' t1 (t2.sub t1) Nat.zero.succ)) →
          n1 + n2 - (t2 - t1) ≤
            List.foldr Nat.add Nat.zero
              (List.map (fun t => (P1 t && P2 t).toNat) (List.range' t1 (t2.sub t1) Nat.zero.succ))
Prosa.Validation.FiniteSumNormalization.sum_ge_2_nat_guard :
  (∀ (t1 t2 : ℕ) (p : ℕ → ℕ),
      (∀ (t : ℕ), p t ≤ 1) →
        2 ≤ ∑ t ∈ Finset.Ico t1 t2, p t →
          ∃ to1 to2, t1 ≤ to1 ∧ to1 < to2 ∧ to2 < t2 ∧ decide (p to1 = 1) = true ∧ decide (p to2 = 1) = true) =
    ∀ (t1 t2 : ℕ) (p : ℕ → ℕ),
      (∀ (t : ℕ), p t ≤ 1) →
        2 ≤ List.foldr Nat.add Nat.zero (List.map (fun t => p t) (List.range' t1 (t2.sub t1) Nat.zero.succ)) →
          ∃ to1 to2, t1 ≤ to1 ∧ to1 < to2 ∧ to2 < t2 ∧ decide (p to1 = 1) = true ∧ decide (p to2 = 1) = true
