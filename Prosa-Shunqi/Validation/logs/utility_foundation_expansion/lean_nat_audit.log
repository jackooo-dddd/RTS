@Prosa.Util.Nat.subnACA : ∀ {m n p q : ℕ},
  LE.le.{0} p m →
    LE.le.{0} q n →
      Eq.{1} (HSub.hSub.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} m n) (HAdd.hAdd.{0, 0, 0} p q))
        (HAdd.hAdd.{0, 0, 0} (HSub.hSub.{0, 0, 0} m p) (HSub.hSub.{0, 0, 0} n q))
@Prosa.Util.Nat.leq_subRL_impl : ∀ {m n p : ℕ},
  LE.le.{0} (HAdd.hAdd.{0, 0, 0} m n) p → LE.le.{0} n (HSub.hSub.{0, 0, 0} p m)
'Prosa.Util.Nat.subnACA' depends on axioms: [propext, Quot.sound]
'Prosa.Util.Nat.leq_subRL_impl' depends on axioms: [propext, Quot.sound]
